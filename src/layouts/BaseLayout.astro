---
// 全站基礎 layout（Mockup C — cabforum.org 結構）。
// banner card + 全寬深色 navbar（SiteHeader）→ 主內容 9/3 grid → 深底 footer。
// 三個 named slot：
//   breadcrumb — 主欄頂部麵包屑
//   sidebar    — 右側 3/12 欄（無 sidebar 時主欄佔滿 12 欄）
//   default    — 主欄內容
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import BackToTop from '../components/BackToTop.astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /**
   * 預留 prop，不再控制主欄寬度（已固定為 9/3 grid 或無 sidebar 時 12/12）。
   * 保留以維持既有頁面相容性，下個 milestone 可清除。
   */
  mainMaxWidth?: string;
}

const { title, description = siteConfig.description } = Astro.props;

const fullTitle = title.includes(siteConfig.name)
  ? title
  : `${title}｜${siteConfig.name}`;

const hasSidebar = Astro.slots.has('sidebar');
const hasBreadcrumb = Astro.slots.has('breadcrumb');
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {/* 站台 icon（scripts/build_logo.py 一併產生，只有「BR」兩個字）：
        SVG 給支援的瀏覽器、ICO 給舊瀏覽器與 Windows 捷徑、180 PNG 給 iOS 加入主畫面。
        ⚠️ 日後若替 GitHub Pages 加上 astro.config 的 base，這些絕對路徑要一起改
        （站內其他連結也是同樣寫法）。 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* spec §4.2 — 在 body 渲染前套用 bilingual class，避免切換時 FOUC */}
    <script is:inline>
      try {
        if (localStorage.getItem('bilingual-mode') === 'on') {
          document.documentElement.classList.add('show-bilingual');
        }
      } catch (_) {
        /* localStorage 不可用時靜默退回預設（純中文） */
      }
    </script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 antialiased" id="top">
    {/* cabforum.org 模式：單一 outer container，
        <lg 全寬（mobile bleed），≥lg 限制 max-width，並隨 viewport 響應放寬以對齊 cabforum.org Bootstrap container-lg：
        lg (≥1024px)=960px / xl (≥1280px)=1140px / 2xl (≥1536px)=1320px。
        Header/Nav/Footer 的 bg 都在此 container 內，自然 mobile 滿版、desktop 對齊。
        body 灰底（slate-100）+ outer container 白底，形成「卡片疊卡片」層次：頁面外是淺灰底，
        外層 container 是白色頁面卡片，內頁再用 .cabf-card 形成 inner cards。 */}
    <div class="mx-auto flex min-h-screen flex-col bg-white lg:max-w-[960px] xl:max-w-[1140px] 2xl:max-w-[1320px]">
      <SiteHeader />

      <div class:list={['flex-1 px-3 mt-4 lg:mt-0', hasSidebar && 'lg:grid lg:grid-cols-12 lg:gap-6']}>
        <div class:list={['min-w-0', hasSidebar && 'lg:col-span-9']}>
          {
            hasBreadcrumb && (
              <div class="border-b border-slate-200 pb-1 mb-2 text-xs font-light text-slate-600">
                <slot name="breadcrumb" />
              </div>
            )
          }

          <main data-pagefind-body>
            <slot />
          </main>
        </div>

        {
          hasSidebar && (
            <aside class="hidden lg:block lg:col-span-3 space-y-8">
              <slot name="sidebar" />
            </aside>
          )
        }
      </div>

      <SiteFooter />
    </div>
    <SearchModal />
    <BackToTop />
  </body>
</html>
