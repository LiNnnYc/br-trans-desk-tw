---
// 全站基礎 layout。頁首、麵包屑（透過 named slot）、主內容、頁尾。
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** 包裹 <main> 的最大寬度 Tailwind class，預設 max-w-3xl（章節閱讀寬度） */
  mainMaxWidth?: string;
}

const {
  title,
  description = siteConfig.description,
  mainMaxWidth = 'max-w-3xl',
} = Astro.props;

const fullTitle = title.includes(siteConfig.name)
  ? title
  : `${title}｜${siteConfig.name}`;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {/* spec §4.2 — 在 body 渲染前套用 bilingual class，避免切換時 FOUC */}
    <script is:inline>
      try {
        if (localStorage.getItem('bilingual-mode') === 'on') {
          document.documentElement.classList.add('show-bilingual');
        }
      } catch (_) {
        /* localStorage 不可用時靜默退回預設（純中文） */
      }
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <div class="flex min-h-screen flex-col">
      <SiteHeader />

      {
        Astro.slots.has('breadcrumb') && (
          <div class="border-b border-slate-100 bg-white">
            <div class="mx-auto max-w-6xl px-4 py-2 sm:px-6 lg:px-8">
              <slot name="breadcrumb" />
            </div>
          </div>
        )
      }

      <main
        class:list={[
          'mx-auto w-full flex-1 px-4 py-8 sm:px-6 sm:py-12 lg:px-8',
          mainMaxWidth,
        ]}
      >
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
