---
// /server-cert-br/table-of-contents/ — Baseline Requirements 章節目錄頁
// （原 /server-cert-br/ 內容，2026-05-25 樣式變更後搬遷至此）。
// 列出 br collection 內所有章節，依 section_id 自然排序、樹狀縮排顯示。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BrSidebarSubmenu from '../../components/BrSidebarSubmenu.astro';
import { getCollection } from 'astro:content';
import { sectionIdToPath } from '../../lib/citation';
import { compareSectionId, sectionIdDepth, sectionIdToLabel } from '../../lib/section';
import { siteConfig } from '../../config/site';

const all = await getCollection('br');

const sorted = [...all].sort((a, b) => compareSectionId(a.data.section_id, b.data.section_id));

const totalCount = sorted.length;
const reviewedCount = sorted.filter((e) => e.data.status === 'reviewed').length;
const translatedCount = sorted.filter((e) => e.data.status === 'translated').length;
const draftCount = sorted.filter((e) => e.data.status === 'draft').length;
// 升版期間會有一批 outdated（原文已變動、譯稿尚未跟上）。不列出來的話，
// 摘要列的加總會少於「已建立節數」，讀者看不出那些節去哪了。
const outdatedCount = sorted.filter((e) => e.data.status === 'outdated').length;
const pendingReviewCount = sorted.filter((e) => e.data.status === 'pending-review').length;

// version 必然是具體版本號（由 br-versions.ts 推導），不再有 'tbd' 佔位狀態。
// lastSyncedAt 是**該版原文的發布日**，不是本站的同步／翻譯日期（翻譯完成日記在
// br-versions.ts 的 translatedAt），故標籤寫「原文發布日」而非「最後同步」。
const { version, lastSyncedAt } = siteConfig.upstream;
---

<BaseLayout
  title="Baseline Requirements 章節目錄"
  description="CA/Browser Forum (Server Cert) Baseline Requirements 各章節中文翻譯目錄。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[
      { label: '首頁', href: '/' },
      { label: '基本要求', href: '/server-cert-br/' },
      { label: '章節目錄' },
    ]}
  />

  <div class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
  <header>
    <h1 class="font-serif-tc text-2xl font-bold text-slate-900 sm:text-3xl">
      Baseline Requirements 章節目錄
    </h1>
    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
      CA/Browser Forum《Server Certificate Baseline Requirements》非官方繁體中文翻譯。
      點選任一章節進入詳細翻譯頁；每頁皆提供整節引用按鈕與跳至原文連結。
    </p>
  </header>

  <dl class="mt-6 grid gap-3 rounded-lg border border-slate-200 bg-slate-50 p-5 text-sm sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">對應原文版本</dt>
      <dd class="mt-1 font-mono text-slate-900">{version}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">原文發布日</dt>
      <dd class="mt-1 text-slate-900">{lastSyncedAt ?? '—'}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">已建立節數</dt>
      <dd class="mt-1 text-slate-900">{totalCount}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">翻譯狀態</dt>
      <dd class="mt-1 text-slate-900 text-xs leading-relaxed">
        已校稿 {reviewedCount}・已翻譯 {translatedCount}・待審閱 {pendingReviewCount}・草稿 {draftCount}・過時 {outdatedCount}
      </dd>
    </div>
  </dl>

  {
    sorted.length === 0 ? (
      <p class="mt-10 rounded-md border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">
        章節內容尚未建立，將隨 M2 翻譯進度逐步上線。
      </p>
    ) : (
      <nav aria-label="章節列表" class="mt-8 rounded-md border border-slate-200 bg-slate-50">
        <ul class="divide-y divide-slate-100">
          {sorted.map((entry) => {
            const d = entry.data;
            const depth = sectionIdDepth(d.section_id);
            const indent = ['pl-4', 'pl-8', 'pl-12', 'pl-16', 'pl-20'][Math.min(depth, 4)];
            const cleanLabel = d.title
              .replace(/^\s*\d+(?:\.\d+)*\s*[、：:.\-—]?\s*/, '')
              .trim() || d.title;
            const statusLabel = {
              draft: '草稿',
              translated: '已翻譯',
              reviewed: '已校稿',
              outdated: '過時',
              'pending-review': '待審閱',
            }[d.status];
            const statusCls = {
              draft: 'text-slate-500',
              translated: 'text-sky-700',
              reviewed: 'text-emerald-700',
              outdated: 'text-amber-700',
              'pending-review': 'text-violet-700',
            }[d.status];
            return (
              <li>
                <a
                  href={`/server-cert-br/${sectionIdToPath(d.section_id)}/`}
                  class:list={[
                    'flex items-center gap-3 py-2.5 pr-4 text-sm hover:bg-slate-50',
                    indent,
                  ]}
                >
                  <span class="font-mono text-xs text-slate-500 w-20 shrink-0">{sectionIdToLabel(d.section_id)}</span>
                  <span class="flex-1 text-slate-800">{cleanLabel}</span>
                  <span class:list={['text-[11px] font-medium shrink-0', statusCls]}>{statusLabel}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
  </div>

  <Fragment slot="sidebar">
    <BrSidebarSubmenu currentPath="/server-cert-br/table-of-contents/" />
  </Fragment>
</BaseLayout>
