---
// /server-cert-br/ — Baseline Requirements 全文頁
// （2026-05-25 樣式變更後，此頁從章節目錄改為全文呈現；
//   章節目錄頁搬至 /server-cert-br/table-of-contents/）。
//
// 規格：web-spec-doc/server-cert-br樣式變更.txt
//   - SSR 串接所有 br entries（依 section_id 自然排序）
//   - 每節 heading 含 cabforum.org 原文錨點與單章節 deep-link
//   - blockquote 透過 .full-text-only-cn 容器 CSS 隱藏（純中文）
//   - 加 data-pagefind-ignore 避免與單章節頁雙重索引
//   - sidebar：BrSidebarSubmenu + BrAnchorNav
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BrSidebarSubmenu from '../../components/BrSidebarSubmenu.astro';
import BrAnchorNav from '../../components/BrAnchorNav.astro';
import BrAnchorNavMobile from '../../components/BrAnchorNavMobile.astro';
import { getCollection, render } from 'astro:content';
import { sectionIdToPath } from '../../lib/citation';
import { siteConfig } from '../../config/site';

const all = await getCollection('br');

function compareSectionId(a: string, b: string) {
  const isAppA = a.startsWith('appendix-');
  const isAppB = b.startsWith('appendix-');
  if (isAppA && !isAppB) return 1;
  if (!isAppA && isAppB) return -1;
  if (isAppA && isAppB) return a.localeCompare(b);
  const ap = a.split('.').map(Number);
  const bp = b.split('.').map(Number);
  const n = Math.max(ap.length, bp.length);
  for (let i = 0; i < n; i++) {
    const av = ap[i] ?? -1;
    const bv = bp[i] ?? -1;
    if (av !== bv) return av - bv;
  }
  return 0;
}

const sorted = [...all].sort((a, b) => compareSectionId(a.data.section_id, b.data.section_id));

// 預先 render 所有 entry 的 <Content />；section_id 深度 ≤ 2 視為 scrollspy 觀察點
const items = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    const id = entry.data.section_id;
    const isAppendix = id.startsWith('appendix-');
    const depth = isAppendix ? 0 : id.split('.').length - 1;
    const slug = id.replace(/\./g, '-');
    const cleanTitle =
      entry.data.title.replace(/^\s*\d+(?:\.\d+)*\s*[、：:.\-—]?\s*/, '').trim() ||
      entry.data.title;
    return { entry, Content, depth, slug, cleanTitle, isAnchorTarget: depth <= 1 || isAppendix };
  })
);

const { version, lastSyncedAt } = siteConfig.upstream;
---

<BaseLayout
  title="《基本要求》全文"
  description="CA/Browser Forum (Server Cert) Baseline Requirements 非官方繁體中文翻譯（全文）。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '基本要求' }]}
  />

  <BrAnchorNavMobile />

  <div class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
  <header class="border-b border-slate-200 pb-4">
    <h1 class="font-serif-tc text-2xl font-bold text-slate-900 sm:text-3xl leading-tight">
      《基本要求》全文
    </h1>
    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
      CA/Browser Forum《Server Certificate Baseline Requirements》非官方繁體中文翻譯，
      對應原文版本 <span class="font-mono">{version === 'tbd' ? '版本待定' : version}</span>
      {lastSyncedAt && <> · 最後同步 <span class="font-mono">{lastSyncedAt}</span></>}。
    </p>
    <p class="mt-2 text-xs text-slate-500 leading-relaxed">
      本頁僅顯示中文翻譯。若需中英對照與整節引用功能，請點各章節標題旁的「
      <span class="inline-flex items-center font-mono">›</span>
      」進入單章節頁。
    </p>
  </header>

  <article class="full-text-only-cn mt-6" data-pagefind-ignore>
    {
      items.map(({ entry, Content, depth, slug, cleanTitle, isAnchorTarget }, idx) => {
        const id = entry.data.section_id;
        const idAttrs = isAnchorTarget
          ? { id: `sec-${slug}`, 'data-anchor-target': '' }
          : { id: `sec-${slug}` };
        const HeadingTag = (
          depth === 0 ? 'h2' :
          depth === 1 ? 'h3' :
          depth === 2 ? 'h4' :
          depth === 3 ? 'h5' : 'h6'
        ) as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
        // 第一個項目（§1）不需要章前大空白與橫線；其餘章標題加：
        //   - mt-20（5rem 上方留白）
        //   - border-t-2 + 灰線 + pt-8（清楚的「換章」橫線視覺，不靠純空白）
        // 不能用 Tailwind `first:` 變體（會 match :first-child，而每個 h2 都是其 section 的
        // first-child，導致所有章節都套到 first 的樣式，章節間距全失靈）。
        const chapterCls = idx === 0
          ? 'mt-6'
          : 'mt-20 border-t-2 border-slate-300 pt-8';
        // 深層級分流：原本 depth 3+ 共用 mt-6，碰到 §7.x.x.x 與 §7.x.x.x.x
        // 連續堆疊時，小字 + 小間距視覺壓得太密。改成 depth 2/3/4+ 各自獨立，
        // 形成連續梯度 12/10/8/7（每層約差 0.25rem），深層仍保有呼吸感。
        const headingSizeCls =
          depth === 0
            ? `text-2xl sm:text-3xl font-bold ${chapterCls}`
            : depth === 1
              ? 'text-xl sm:text-2xl font-bold mt-12'
              : depth === 2
                ? 'text-lg sm:text-xl font-semibold mt-10'
                : 'text-base sm:text-lg font-semibold mt-8';
        return (
          <section {...idAttrs} class="full-text-section">
            <HeadingTag class:list={['font-serif-tc text-slate-900 leading-tight scroll-mt-20 group', headingSizeCls]}>
              <span class="font-mono text-bs-secondary mr-2">{id}</span>
              <span>{cleanTitle}</span>
              <span class="ml-2 inline-flex items-center gap-1 align-middle text-xs font-normal opacity-60 group-hover:opacity-100 transition">
                <a
                  href={`/server-cert-br/${sectionIdToPath(id)}/`}
                  class="inline-flex items-center rounded border border-slate-300 px-1.5 py-0.5 text-slate-600 hover:border-bs-primary hover:text-bs-secondary"
                  aria-label={`${id} 單章節頁（含中英對照、引用）`}
                  title="單章節頁（含中英對照、引用）"
                >
                  詳細頁
                </a>
                <a
                  href={entry.data.original_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center rounded border border-slate-300 px-1.5 py-0.5 text-slate-600 hover:border-bs-primary hover:text-bs-secondary"
                  aria-label={`${id} cabforum.org 原文`}
                  title="cabforum.org 原文"
                >
                  原文 ↗
                </a>
              </span>
            </HeadingTag>
            <div class="clause-body">
              <Content />
            </div>
          </section>
        );
      })
    }
  </article>
  </div>

  <Fragment slot="sidebar">
    <BrSidebarSubmenu currentPath="/server-cert-br/" />
    <BrAnchorNav />
  </Fragment>
</BaseLayout>
