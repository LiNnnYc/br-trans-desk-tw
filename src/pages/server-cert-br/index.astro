---
// /server-cert-br/ — Baseline Requirements 全文頁
// （2026-05-25 樣式變更後，此頁從章節目錄改為全文呈現；
//   章節目錄頁搬至 /server-cert-br/table-of-contents/）。
//
// 規格：web-spec-doc/server-cert-br樣式變更.txt
//   - SSR 串接所有 br entries（依 section_id 自然排序）
//   - 每節 heading：章節編號連到單章節頁、錨點連結圖示（比照 cabforum.org）、原文連結
//   - blockquote 透過 .full-text-only-cn 容器 CSS 隱藏（純中文）
//   - 加 data-pagefind-ignore 避免與單章節頁雙重索引
//   - sidebar：BrSidebarSubmenu + BrAnchorNav
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BrSidebarSubmenu from '../../components/BrSidebarSubmenu.astro';
import BrAnchorNav from '../../components/BrAnchorNav.astro';
import BrAnchorNavMobile from '../../components/BrAnchorNavMobile.astro';
import DocVersionBadge from '../../components/DocVersionBadge.astro';
import { getCollection, render } from 'astro:content';
import { sectionIdToPath } from '../../lib/citation';
import { compareSectionId, sectionIdDepth, sectionIdToLabel } from '../../lib/section';

const all = await getCollection('br');

const sorted = [...all].sort((a, b) => compareSectionId(a.data.section_id, b.data.section_id));

// ── 註腳：搬到全文最下方（比照 cabforum.org 原文把註腳放在文件末尾）──────────
//
// scripts/rehype-footnotes.mjs 已把每個章節檔的註腳整理成
// `<section class="clause-footnotes">`（單章節頁直接用這份，落在該節內文最下方）。
// 全文頁則把各節的註腳區抽掉，依 label 合併成整份文件末尾的單一清單：
//   - 同一個 label（如 `eku_ca` 在 5 個章節各定義一份、內容相同）合併成一條，
//     編號依全文首次出現順序（1、2、3…）。
//   - 內文引用的 href 改指向文件層級的 `#fn-<label>`，顯示數字改成全文編號。
//   - 註腳的回鏈列出所有引用它的章節，點了跳回該節內文標記處。
//   - 英文原文側（blockquote 內）的引用在全文頁本來就隱藏，不列入回鏈。
//
// 以字串處理 entry.rendered.html：因為要改寫引用與抽走註腳區，<Content /> 拿不到
// 可改寫的 HTML。若 rendered.html 不存在（理論上不會，content layer 會存），
// 退回原本的 <Content />，此時該節註腳維持顯示在節內（功能不壞、只是位置不同）。
const FN_SECTION_RE = /<section\b[^>]*\bclass="clause-footnotes"[^>]*>[\s\S]*?<\/section>/;
const FN_OL_RE = /<ol\b[^>]*>([\s\S]*)<\/ol>/;
const FN_LI_RE = /^<li\b[^>]*>([\s\S]*)<\/li>\s*$/;
const FN_LABEL_RE = /<li\b[^>]*\bdata-fn-label="([^"]+)"/;
// class 可能是 "fn-backref" 或 "fn-backref fn-backref-en"（英文原文側）
const FN_BACKREF_RE = /\s*<a\b[^>]*\bclass="fn-backref[^"]*"[^>]*>[\s\S]*?<\/a>/g;
const FN_REF_RE = /<a\b[^>]*\bdata-fn-label="[^"]*"[^>]*>[^<]*<\/a>/g;

type BackrefGroup = { sec: string; refIds: string[] };
type DocFootnote = { label: string; defHtml: string; groups: BackrefGroup[] };

const docFootnotes: DocFootnote[] = [];
const docFootnoteByLabel = new Map<string, DocFootnote>();

/** 取得（或建立）文件層級註腳；回傳其全文編號（1-based）。 */
function registerFootnote(label: string, defHtml: string | null) {
  let fn = docFootnoteByLabel.get(label);
  if (!fn) {
    fn = { label, defHtml: defHtml ?? '', groups: [] };
    docFootnoteByLabel.set(label, fn);
    docFootnotes.push(fn);
  }
  // 引用（EN blockquote）可能出現在定義被解析出來之前，補上定義內容
  if (!fn.defHtml && defHtml) fn.defHtml = defHtml;
  return docFootnotes.indexOf(fn) + 1;
}

function addBackref(label: string, sec: string, refId: string) {
  const fn = docFootnoteByLabel.get(label);
  if (!fn) return;
  const group = fn.groups.find((g) => g.sec === sec);
  if (group) group.refIds.push(refId);
  else fn.groups.push({ sec, refIds: [refId] });
}

/** 抽掉章節內的註腳區，回傳 {本文, label → 定義 HTML（已去回鏈）} */
function extractFootnoteDefs(html: string) {
  const found = html.match(FN_SECTION_RE);
  if (!found || found.index === undefined) return { body: html, defs: new Map<string, string>() };
  const body = html.slice(0, found.index) + html.slice(found.index + found[0].length);
  const defs = new Map<string, string>();
  const ol = found[0].match(FN_OL_RE);
  if (ol) {
    // 以 `<li id="fn-…"` 為界切開；註腳內若有巢狀清單，其 <li> 無此 id，不會誤切
    for (const chunk of ol[1].split(/(?=<li id="fn-)/)) {
      const item = chunk.trim();
      if (!item) continue;
      const label = item.match(FN_LABEL_RE)?.[1];
      const inner = item.match(FN_LI_RE)?.[1];
      if (label && inner) defs.set(label, inner.replace(FN_BACKREF_RE, ''));
    }
  }
  return { body, defs };
}

/** 改寫本文中的註腳引用：指向文件層級 id、顯示全文編號，並登記回鏈 */
function rewriteFootnoteRefs(body: string, defs: Map<string, string>) {
  return body.replace(FN_REF_RE, (tag) => {
    const raw = tag.match(/\bdata-fn-label="([^"]+)"/)?.[1];
    if (!raw) return tag;
    // 英文註腳（`<label>_en`）在全文頁不出現，其引用併到中文那條
    const label = raw.replace(/_en$/, '');
    const num = registerFootnote(label, defs.get(label) ?? null);
    const sec = tag.match(/\bdata-fn-sec="([^"]+)"/)?.[1] ?? '';
    const refId = tag.match(/\bid="([^"]+)"/)?.[1] ?? '';
    // 英文原文側的引用在全文頁隱藏（.full-text-only-cn blockquote），不做回鏈
    if (!/\bdata-fn-en\b/.test(tag) && sec && refId) addBackref(label, sec, refId);
    return tag
      .replace(/\bhref="[^"]*"/, `href="#fn-${label}"`)
      // 節內註腳標題已被抽掉，改指向全文末尾註腳區的標題
      .replace(/\baria-describedby="[^"]*"/, 'aria-describedby="doc-footnotes-title"')
      .replace(/>[^<]*<\/a>$/, `>${num}</a>`);
  });
}

// 預先 render 所有 entry 的內容；section_id 深度 ≤ 2 視為 scrollspy 觀察點
const items = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    const id = entry.data.section_id;
    const depth = sectionIdDepth(id);
    const slug = id.replace(/\./g, '-');
    // 該節在 cabforum.org 的錨點（取自 original_url 的 fragment）。掛在標題上，
    // 讓譯稿內文沿用原文寫法的交叉參照（由 scripts/rehype-section-links.mjs 改寫成
    // /server-cert-br/#<錨點>）有落點；錨點名與原文相同，網域對調即可對照英文原文。
    const originalAnchor = entry.data.original_url.split('#')[1] ?? null;
    const cleanTitle =
      entry.data.title.replace(/^\s*\d+(?:\.\d+)*\s*[、：:.\-—]?\s*/, '').trim() ||
      entry.data.title;
    return {
      entry,
      Content,
      originalAnchor,
      rawHtml: entry.rendered?.html ?? null,
      bodyHtml: null as string | null,
      depth,
      slug,
      cleanTitle,
      isAnchorTarget: depth <= 1,
    };
  })
);

// 註腳的全文編號依「文件順序」決定，故此處必須循序處理（不可放進上面的
// Promise.all，並行的 await 會讓登記順序不確定）。
for (const item of items) {
  if (item.rawHtml === null) continue;
  const { body, defs } = extractFootnoteDefs(item.rawHtml);
  item.bodyHtml = rewriteFootnoteRefs(body, defs);
}

---

<BaseLayout
  title="《基本要求》全文"
  description="CA/Browser Forum TLS Baseline Requirements 非官方繁體中文翻譯（全文）。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '基本要求' }]}
  />

  <BrAnchorNavMobile />

  <div class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
  <header class="border-b border-slate-200 pb-4">
    <!-- 比照 cabforum.org TLS BR 頁：標題與版本／日期徽章同一列、兩端對齊。
         窄螢幕時 flex-wrap 讓徽章掉到標題下方，不去壓縮標題。 -->
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <h1 class="font-serif-tc text-2xl font-bold text-slate-900 sm:text-3xl leading-tight">
        《基本要求》全文
      </h1>
      <DocVersionBadge />
    </div>
    <!-- 版本與日期已由上方 DocVersionBadge 呈現，此處不再重複「對應原文版本／最後同步」。 -->
    <p class="mt-4 text-sm text-slate-600 leading-relaxed">
      CA/Browser Forum《Baseline Requirements for the Issuance and Management of Publicly-Trusted TLS Server Certificates》
    </p>
    <p class="mt-1 text-sm text-slate-600 leading-relaxed">非官方繁體中文翻譯</p>
  </header>

  <article class="full-text-only-cn mt-6" data-pagefind-ignore>
    {
      items.map(({ entry, Content, bodyHtml, depth, slug, cleanTitle, isAnchorTarget, originalAnchor }, idx) => {
        const id = entry.data.section_id;
        const label = sectionIdToLabel(id);
        const idAttrs = isAnchorTarget
          ? { id: `sec-${slug}`, 'data-anchor-target': '' }
          : { id: `sec-${slug}` };
        const HeadingTag = (
          depth === 0 ? 'h2' :
          depth === 1 ? 'h3' :
          depth === 2 ? 'h4' :
          depth === 3 ? 'h5' : 'h6'
        ) as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
        // 第一個項目（§1）不需要章前大空白與橫線；其餘章標題加：
        //   - mt-20（5rem 上方留白）
        //   - border-t-2 + 灰線 + pt-8（清楚的「換章」橫線視覺，不靠純空白）
        // 不能用 Tailwind `first:` 變體（會 match :first-child，而每個 h2 都是其 section 的
        // first-child，導致所有章節都套到 first 的樣式，章節間距全失靈）。
        const chapterCls = idx === 0
          ? 'mt-6'
          : 'mt-20 border-t-2 border-slate-300 pt-8';
        // 深層級分流：原本 depth 3+ 共用 mt-6，碰到 §7.x.x.x 與 §7.x.x.x.x
        // 連續堆疊時，小字 + 小間距視覺壓得太密。改成 depth 2/3/4+ 各自獨立，
        // 形成連續梯度 12/10/8/7（每層約差 0.25rem），深層仍保有呼吸感。
        const headingSizeCls =
          depth === 0
            ? `text-2xl sm:text-3xl font-bold ${chapterCls}`
            : depth === 1
              ? 'text-xl sm:text-2xl font-bold mt-12'
              : depth === 2
                ? 'text-lg sm:text-xl font-semibold mt-10'
                : 'text-base sm:text-lg font-semibold mt-8';
        return (
          <section {...idAttrs} class="full-text-section">
            <HeadingTag id={originalAnchor} class:list={['font-serif-tc text-slate-900 leading-tight scroll-mt-20', headingSizeCls]}>
              <!-- 章節編號即單章節頁（含中英對照、引用）的入口 -->
              <a
                href={`/server-cert-br/${sectionIdToPath(id)}/`}
                class="font-mono text-bs-secondary mr-2 underline decoration-transparent underline-offset-4 hover:decoration-current transition"
                aria-label={`${label} 單章節頁（含中英對照、引用）`}
                title="單章節頁（含中英對照、引用）"
              >{label}</a>
              <span>{cleanTitle}</span>
              <!-- 比照 cabforum.org 的 header-link：標題後方常駐的錨點連結圖示（Bootstrap Icons link-45deg）。
                   「原文」鈕只在滑鼠移到按鈕本身時才高亮，不隨標題 hover 變化。 -->
              <a
                href={`#${originalAnchor ?? `sec-${slug}`}`}
                class="ml-2 inline-flex align-middle text-bs-secondary hover:text-bs-primary transition"
                aria-label={`${label} 本節錨點連結`}
                title="本節錨點連結"
              >
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z"/>
                  <path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z"/>
                </svg>
              </a>
              <span class="ml-2 inline-flex items-center align-middle text-xs font-normal">
                <a
                  href={entry.data.original_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center rounded border border-slate-300 px-1.5 py-0.5 text-slate-600 opacity-60 transition hover:opacity-100 hover:border-bs-primary hover:text-bs-secondary"
                  aria-label={`${label} cabforum.org 原文`}
                  title="cabforum.org 原文"
                >
                  原文 ↗
                </a>
              </span>
            </HeadingTag>
            {
              bodyHtml !== null ? (
                <div class="clause-body" set:html={bodyHtml} />
              ) : (
                <div class="clause-body">
                  <Content />
                </div>
              )
            }
          </section>
        );
      })
    }

    {
      docFootnotes.length > 0 && (
        <section id="footnotes" class="doc-footnotes clause-body" aria-labelledby="doc-footnotes-title">
          <h2 id="doc-footnotes-title" class="clause-footnotes-title">註腳</h2>
          <ol>
            {docFootnotes.map((fn) => (
              <li id={`fn-${fn.label}`}>
                <Fragment set:html={fn.defHtml} />
                {fn.groups.length > 0 && (
                  <span class="fn-backrefs">
                    <span class="fn-backrefs-label">回到內文：</span>
                    {fn.groups.map((g) => (
                      <span class="fn-backref-group">
                        <a
                          class="fn-backref"
                          href={`#${g.refIds[0]}`}
                          aria-label={`回到第 ${g.sec} 節的引用處`}
                        >
                          §{g.sec}
                        </a>
                        {g.refIds.slice(1).map((refId, i) => (
                          <a
                            class="fn-backref fn-backref-extra"
                            href={`#${refId}`}
                            aria-label={`回到第 ${g.sec} 節第 ${i + 2} 處引用`}
                          >
                            <sup>{i + 2}</sup>
                          </a>
                        ))}
                      </span>
                    ))}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>
  </div>

  <Fragment slot="sidebar">
    <BrSidebarSubmenu currentPath="/server-cert-br/" />
    <BrAnchorNav />
  </Fragment>
</BaseLayout>
