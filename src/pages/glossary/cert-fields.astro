---
// /glossary/cert-fields/ — 憑證欄位譯名對照（術語表的第二個分頁）。
// 資料全部來自 src/config/cert-field-mappings.ts；中文欄位名是從 Windows 與 Chrome
// 的在地化資源實際抽出來的，不是本站翻的，改動請看該檔開頭的註解。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GlossaryTabs from '../../components/GlossaryTabs.astro';
import {
  certFieldTables,
  certFieldGaps,
  captureInfo,
  type FieldRow,
} from '../../config/cert-field-mappings';

/** 該表是否需要「備註」欄 */
const hasNotes = (rows: FieldRow[]) => rows.some((r) => r.note);

/**
 * 表格用 table-fixed + colgroup 指定欄寬比例。
 * 交給瀏覽器自動分配的話，備註欄的文字最長、會吃掉三成以上的寬度，
 * 譯名欄被擠到換行；內層 div 限寬也擋不住——auto layout 仍會把剩餘空間按比例分給它。
 */
function columnWidths(showZh: boolean, notes: boolean): string[] {
  if (showZh && notes) return ['21%', '16%', '22%', '22%', '19%'];
  if (showZh) return ['24%', '20%', '28%', '28%'];
  if (notes) return ['24%', '28%', '28%', '20%'];
  return ['30%', '35%', '35%'];
}
---

<BaseLayout
  title="憑證欄位譯名對照"
  description="RFC 5280 憑證欄位、擴充欄位、DN 屬性在 Windows 憑證檢視器與 Chrome 憑證檢視器下的繁體中文顯示名稱對照。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[
      { label: '首頁', href: '/' },
      { label: '術語表', href: '/glossary/' },
      { label: '憑證欄位譯名對照' },
    ]}
  />

  <article class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
    <header>
      <h1 class="text-2xl font-semibold text-slate-900 sm:text-3xl">憑證欄位譯名對照</h1>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        同一個憑證欄位，在本站譯文、Windows 憑證檢視器與 Chrome 憑證檢視器中各有不同的翻譯。
        這讓我們在討論某個 X.509 憑證欄位內容時，容易出現「詞不達意」的情況。
        因此以下為各位整理 X.509 憑證欄位和模組在本站、Windows 憑證檢視器，以及 Chrome 憑證檢視器中的翻譯對照表。
        Windows 與 Chrome 兩欄的中文翻譯來源，為網站管理者從兩者安裝資料夾下的繁體中文 UI 文字檔，抽取出來的 UI 顯示文字。
      </p>
    </header>

    <GlossaryTabs current="cert-fields" />

    <nav
      aria-label="表格索引"
      class="mt-6 flex flex-wrap items-center gap-1 rounded-md border border-slate-200 bg-white p-2 text-sm"
      data-pagefind-ignore
    >
      {
        certFieldTables.map((t) => (
          <a
            href={`#${t.id}`}
            class="inline-flex h-8 items-center justify-center rounded px-2 font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400"
          >
            {t.navLabel ?? t.title.split('（')[0].split('：')[0]}
          </a>
        ))
      }
      <span aria-hidden="true" class="mx-1 h-5 w-px bg-slate-200"></span>
      <a
        href="#gaps"
        class="inline-flex h-8 items-center justify-center rounded px-2 font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400"
      >
        翻譯講評
      </a>
    </nav>

    <div class="mt-8 space-y-10">
      {
        certFieldTables.map((table) => {
          const notes = hasNotes(table.rows);
          const widths = columnWidths(table.showZh, notes);
          return (
            <section id={table.id} aria-labelledby={`heading-${table.id}`}>
              <h2
                id={`heading-${table.id}`}
                class="border-b border-slate-200 pb-1 text-lg font-semibold text-slate-800"
              >
                {table.title}
                {table.ref && (
                  <span class="ml-2 align-middle text-xs font-normal text-slate-500">{table.ref}</span>
                )}
              </h2>
              {table.intro && (
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{table.intro}</p>
              )}
              <div class="mt-4 overflow-x-auto rounded-md border border-slate-200">
                <table class="w-full min-w-[60rem] table-fixed text-sm">
                  <colgroup>
                    {widths.map((w) => (
                      <col style={`width:${w}`} />
                    ))}
                  </colgroup>
                  <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
                    <tr>
                      <th scope="col" class="px-4 py-2 font-semibold">{table.keyHeader}</th>
                      {table.showZh && (
                        <th scope="col" class="px-4 py-2 font-semibold">本站譯名</th>
                      )}
                      <th scope="col" class="px-4 py-2 font-semibold">Windows 憑證檢視器</th>
                      <th scope="col" class="px-4 py-2 font-semibold">Chrome 憑證檢視器</th>
                      {notes && <th scope="col" class="px-4 py-2 font-semibold">備註</th>}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 text-slate-700">
                    {table.rows.map((row) => (
                      <tr class="align-top">
                        <td
                          class={[
                            'px-4 py-3 font-medium text-slate-900 break-words',
                            table.mono ? 'font-mono text-[0.8125rem]' : '',
                          ].join(' ')}
                        >
                          {row.key}
                          {row.oid && (
                            <div class="mt-0.5 font-mono text-xs font-normal text-slate-500">{row.oid}</div>
                          )}
                        </td>
                        {table.showZh && (
                          <td class="px-4 py-3">
                            {row.zh ? (
                              <span class="font-medium text-slate-900">{row.zh}</span>
                            ) : (
                              <span class="text-slate-400">—</span>
                            )}
                          </td>
                        )}
                        <td class="px-4 py-3 break-words">
                          {row.winZh ? (
                            <>
                              <span>{row.winZh}</span>
                              {row.winEn && (
                                <div lang="en" class="mt-0.5 text-xs text-slate-500">{row.winEn}</div>
                              )}
                            </>
                          ) : row.winRaw ? (
                            <span lang="en" class="font-mono text-xs text-slate-600">{row.winRaw}</span>
                          ) : (
                            <span class="text-slate-400">—</span>
                          )}
                        </td>
                        <td class="px-4 py-3 break-words">
                          {row.chromeZh ? (
                            <>
                              <span>{row.chromeZh}</span>
                              {row.chromeEn && (
                                <div lang="en" class="mt-0.5 text-xs text-slate-500">{row.chromeEn}</div>
                              )}
                            </>
                          ) : row.chromeRaw ? (
                            <span class="font-mono text-xs text-slate-600">{row.chromeRaw}</span>
                          ) : (
                            <span class="text-slate-400">—</span>
                          )}
                        </td>
                        {notes && (
                          <td class="px-4 py-3 text-xs leading-relaxed text-slate-500">
                            <div>{row.note}</div>
                          </td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          );
        })
      }

      <section id="gaps" aria-labelledby="heading-gaps">
        <h2
          id="heading-gaps"
          class="border-b border-slate-200 pb-1 text-lg font-semibold text-slate-800"
        >
          翻譯講評
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          以下是各翻譯比較不一致的地方，也容易在討論中鬼打牆的地方。
        </p>
        <ol class="mt-4 space-y-4">
          {
            certFieldGaps.map((gap, i) => (
              <li class="rounded-md border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-900">
                  <span class="mr-1.5 font-mono text-slate-500">{i + 1}.</span>
                  {gap.title}
                </p>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-700">{gap.body}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <footer class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-500">
      <p class="mb-2">繁體中文 UI 界面文字的來源（{captureInfo.date} 抽取）：</p>
      <ul class="list-disc space-y-1 pl-6">
        <li>
          Windows 憑證檢視器：{captureInfo.windows} 的 <code class="font-mono text-xs">cryptui.dll.mui</code>（檢視器 Layout）與
          <code class="font-mono text-xs">crypt32.dll.mui</code>（擴充欄位、DN 屬性、EKU 名稱），繁體中文與英文兩份字串表以字串 ID 對照。
        </li>
        <li>
          Chrome 憑證檢視器：Chrome {captureInfo.chromeVersion} 的
          <code class="font-mono text-xs">Locales\zh-TW.pak</code> 與
          <code class="font-mono text-xs">Locales\en-US.pak</code>，以 resource id 對照。
        </li>
        <li>RFC 5280 欄位、ASN.1 與 OID：RFC 5280 Appendix A。</li>
      </ul>
      <p class="mt-3 text-xs leading-relaxed">
        兩個檢視器的 UI 顯示文字會隨版本改變，表中內容為上述版本的抽取結果。
      </p>
    </footer>
  </article>
</BaseLayout>
