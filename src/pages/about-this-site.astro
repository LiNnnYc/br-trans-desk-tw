---
// /about-this-site/ — 關於本站（spec §9.2、PRD §7/§8）。
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="關於本站"
  description="本站的翻譯規則、聯絡資訊、授權與引用方式等雜項。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '關於本站' }]}
  />

  <article class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
    <header class="border-b border-slate-200 pb-4">
      <h1 class="font-serif-tc text-2xl font-bold text-slate-900 sm:text-3xl leading-tight">
        關於本站
      </h1>
      <p class="mt-2 text-sm text-slate-600">
        本站定位、翻譯規則、授權與聯絡資訊、一些雜項。
      </p>
    </header>

    <div class="mt-6">
      <h2 class="font-serif-tc text-xl font-bold text-slate-900 sm:text-2xl leading-normal pb-2">BR 翻譯小站（BR Trans Desk）</h2>
        <p class="mt-1">提供 Web PKI 相關文件的<strong style="font-weight: 600; color: var(--bs-secondary)">非官方繁體中文翻譯</strong>，由社群獨立維護，與原文著作單位無從屬關係。</p>
        <p class="mt-3">主要對象為台灣 Web PKI 相關從業人員、購買憑證的用戶，對其提供可參考的繁體中文翻譯。</p>
    </div>

    <div class="clause-body mt-6">

      <h2>翻譯規則</h2>
      <ul>
        <li>翻譯流程：AI 初譯 → 管理者校稿 → 公開合併。</li>
        <li>翻譯會盡量以中英對照的形式呈現。</li>
        <li>技術名詞翻譯以臺灣官方、主要業者為主，若無適當翻譯，則由本站自行決定。</li>
        <li>原文版本更新後，目標 60 天內完成翻譯與上線。</li>
      </ul>

      <h2>免責聲明</h2>
      <p>
        本站翻譯皆為非官方翻譯，發生爭議時以原文內容為準。本網站內容不構成法律意見。
      </p>

      <h2>授權與引用</h2>
      <ul>
        <li>原文採 <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a> 授權；本站翻譯內容亦以 CC BY 4.0 釋出。</li>
        <li>引用本站翻譯內容請註明出處：站名 + 翻譯頁網址 + 對應原文版本。</li>
      </ul>

      <h2>管理者與聯絡資訊</h2>
      <p>本站管理者：LiNnnYc（單人作業）。</p>
      <p>勘誤請聯絡
        <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
        或 GitHub Issue 回報，詳見 <a href="/contact/">聯絡方式</a>。
      </p>

      <h2>無社群網站帳號聲明</h2>
      <p>
        本站不使用 GitHub 以外的社群網站，若於其他社群網站發現假藉本站名義活動之帳號，<strong>應視為假帳號</strong>，請謹慎應對。
      </p>

      <h2>無法繼續聲明（Dead man's switch）</h2>
      <p>
        若本站連續 <strong>6 個月以上無任何更新</strong>，即視為停止維護。歡迎社群 fork 接手翻譯與維運；原 repo 將保留歷史內容以供參考。
      </p>

      <h2>分析工具</h2>
      <p>
        本站採用 <a href="https://www.goatcounter.com/" target="_blank" rel="noopener noreferrer">GoatCounter</a> 進行匿名訪客流量統計，
        <strong>不使用 cookie、不跨站追蹤、不與 Google Analytics 等第三方共享</strong>；
        統計資料僅用於評估翻譯內容是否被實際引用。GoatCounter 不儲存 IP 位址與完整的瀏覽器識別字串，詳見其<a href="https://www.goatcounter.com/help/privacy" target="_blank" rel="noopener noreferrer">隱私權政策</a>。
      </p>
    </div>

  </article>
</BaseLayout>
