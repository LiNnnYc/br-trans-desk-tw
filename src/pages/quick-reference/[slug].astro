---
// /quick-reference/<slug>/ — 客服爭議卡片詳細頁。
// 版面順序刻意與撰寫順序一致（見 src/content/quick-reference/ 的內文結構）：
//   封面簡答（引用區塊）→ 先講道理（不談規範）→ 舉個例子 → 《基本要求》的規定。
// 簡答用獨立的引用區塊樣式，**不放進 `.clause-body`**——那裡的 <blockquote> 語意
// 已被「英文原文對照」佔用（global.css，中文模式會隱藏），混用會讓簡答在全文頁樣式下消失。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { sectionIdToLabel } from '../../lib/section';

export async function getStaticPaths() {
  const all = await getCollection('quick-reference');
  return all.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// 對應章節：附上本站章節頁的標題，客服不必點進去就知道那節在講什麼
const brEntries = await getCollection('br');
const related = d.related_sections.map((id) => {
  const hit = brEntries.find((e) => e.data.section_id === id);
  return {
    id,
    label: sectionIdToLabel(id),
    href: `/server-cert-br/${id.replace(/\./g, '-')}/`,
    title: hit?.data.title.replace(/\s*（[^）]*）\s*$/, '') ?? null,
  };
});

const isoUpdated = d.last_updated.toISOString().slice(0, 10);
const description = `${d.question} ${d.short_answer}`.slice(0, 150);
---

<BaseLayout title={d.question} description={description} mainMaxWidth="max-w-4xl">
  <Breadcrumb
    slot="breadcrumb"
    items={[
      { label: '首頁', href: '/' },
      { label: '快速參考', href: '/quick-reference/' },
      { label: d.question },
    ]}
  />

  <article class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
    <header class="border-b border-slate-200 pb-5">
      <h1 class="font-serif-tc text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">
        {d.question}
      </h1>
      <blockquote
        class="mt-4 border-l-4 border-bs-primary bg-bs-primary-soft/40 py-2 pl-4 pr-3 text-base leading-relaxed text-slate-700"
      >
        {d.short_answer}
      </blockquote>
    </header>

    <div class="clause-body mt-6">
      <Content />
    </div>

    <footer class="mt-8 border-t border-slate-200 pt-4">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
        對應的《基本要求》章節細項
      </h2>
      <ul role="list" class="mt-3 space-y-2">
        {
          related.map((r) => (
            <li class="text-sm">
              <a
                href={r.href}
                class="text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary"
              >
                <span class="font-mono">§{r.label}</span>
                {r.title && <span class="ml-1">{r.title}</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs text-slate-500">
        最後更新：<time datetime={isoUpdated}>{isoUpdated}</time>
      </p>
    </footer>
  </article>
</BaseLayout>
