---
// /quick-reference/ — 客服快速引用頁（spec §4.4、PRD §4.4、M1-7）。
// 卡片網格：桌機 3 欄、手機 1 欄。
// 6 張預設 placeholder 卡片（內容稿待 M2-Q 翻譯任務填入）。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('quick-reference');
const sorted = [...all].sort((a, b) => a.data.slug.localeCompare(b.data.slug));

// 預設清單（PRD §4.4 / milestones M2-Q1~Q6）；M2 填入正式內容前以骨架卡顯示。
const placeholders = [
  { slug: 'why-validate-domain', question: '為什麼申請憑證需要佐證網站控管權？', refs: ['3.2.2.4'] },
  { slug: 'why-foreign-ip-needed', question: '為什麼佐證網站控管權需要開放國外 IP 存取？', refs: ['3.2.2.4'] },
  { slug: 'why-shorter-validity', question: '為什麼 TLS／SSL 憑證效期縮短至 398／47 天？', refs: ['6.3.2'] },
  { slug: 'why-no-internal-name', question: '為什麼不能申請內網主機網址或私有 IP？', refs: ['3.2.2.6', '7.1.4.2'] },
  { slug: 'why-caa-check', question: '為什麼需要檢查 CAA 紀錄？', refs: ['3.2.2.8'] },
  { slug: 'multi-domain-vs-wildcard', question: '多網域憑證與萬用網域憑證的差別？', refs: ['3.2.2.6'] },
];

const cards = placeholders.map((p) => {
  const real = sorted.find((e) => e.data.slug === p.slug);
  return real
    ? {
        slug: real.data.slug,
        question: real.data.question,
        shortAnswer: real.data.short_answer,
        refs: real.data.related_sections,
        ready: true as const,
      }
    : {
        slug: p.slug,
        question: p.question,
        shortAnswer: '（內容撰寫中，將於 M2-Q 階段填入。）',
        refs: p.refs,
        ready: false as const,
      };
});
---

<BaseLayout
  title="客服快速引用"
  description="台灣 CA 客戶服務常被問到的憑證爭議點，附對應 Baseline Requirements 條款連結。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '快速參考' }]}
  />

  <header>
    <h1 class="font-serif-tc text-2xl font-bold text-slate-900 sm:text-3xl">
      客服快速引用
    </h1>
    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
      台灣 CA 客戶服務常被問到的憑證爭議點，每張卡片連回對應的 Baseline Requirements 章節細項，方便直接複製引用。
    </p>
  </header>

  <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((c) => (
        <li class="cabf-card bg-white border border-slate-200 rounded p-5 flex flex-col">
          <h2 class="font-serif-tc text-base font-bold text-slate-900 leading-snug">
            {c.question}
          </h2>
          <p class="mt-3 text-sm text-slate-700 leading-relaxed flex-1">
            {c.shortAnswer}
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 text-xs">
            <div class="text-slate-500">對應章節：</div>
            <ul class="mt-1 flex flex-wrap gap-x-3 gap-y-1">
              {c.refs.map((r) => (
                <li>
                  <a
                    href={`/server-cert-br/${r.replace(/\./g, '-')}/`}
                    class="font-mono text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary"
                  >
                    §{r}
                  </a>
                </li>
              ))}
            </ul>
            {!c.ready && (
              <span class="mt-2 inline-flex items-center rounded border border-amber-300 bg-amber-50 px-1.5 py-0.5 text-[10px] font-medium text-amber-800">
                撰寫中
              </span>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <p class="mt-8 text-xs leading-relaxed text-slate-500">
    本頁卡片內容於 <strong>M2-Q</strong> 階段與主文件翻譯並行撰寫。引用對應章節時，請直接於章節頁使用「複製引用」按鈕，輸出格式內含免責聲明與原文連結。
  </p>
</BaseLayout>
