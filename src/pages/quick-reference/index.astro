---
// /quick-reference/ — 常見問題快速參考頁（spec §4.4、PRD §4.4、M1-7）。
// 卡片網格：桌機 3 欄、手機 1 欄。封面只放「問題 + 引用區塊簡答」，
// 對應章節與完整說明（道理／範例／《基本要求》規定）都在 /quick-reference/<slug>/ 詳細頁。
// `related_sections` 在封面不顯示，但仍用於卡片排序的後備條件。
// 內容全部來自 quick-reference collection；不再有寫死的 placeholder 清單。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { compareSectionId } from '../../lib/section';

const all = await getCollection('quick-reference');

// 顯示順序：`order`（由淺入深，人工決定）優先，未填者退回以最小的對應章節號排序
const cards = [...all]
  .map((entry) => ({
    slug: entry.data.slug,
    order: entry.data.order,
    question: entry.data.question,
    shortAnswer: entry.data.short_answer,
    refs: [...entry.data.related_sections].sort(compareSectionId),
  }))
  .sort(
    (a, b) =>
      a.order - b.order ||
      compareSectionId(a.refs[0], b.refs[0]) ||
      a.slug.localeCompare(b.slug),
  );
---

<BaseLayout
  title="常見問題快速參考"
  description="申請憑證常見問題的快速參考解答。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '快速參考' }]}
  />

  {/* mt-6：麵包屑與標題之間的留白。BaseLayout 的麵包屑容器只給 mb-2，
      這裡單獨加大，不影響其他頁面。 */}
  <header class="mt-6">
    <h1 class="font-serif-tc text-2xl font-bold text-slate-900 sm:text-3xl">
      常見問題快速參考
    </h1>
    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
      以下整理申請憑證時，常見問題的快速參考解答。每張問題卡片除了封面的簡短回答外，點擊詳細說明還可看完整說明、實際例子。
    </p>
  </header>

  {
    cards.length === 0 ? (
      <p class="mt-6 rounded border border-slate-200 bg-slate-50 p-5 text-sm text-slate-600">
        尚未建立卡片內容。
      </p>
    ) : (
      <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {cards.map((c) => (
          <li class="cabf-card flex flex-col rounded border border-slate-200 bg-white p-5">
            <h2 class="font-serif-tc text-base font-bold leading-snug text-slate-900">
              <a
                href={`/quick-reference/${c.slug}/`}
                class="hover:text-bs-secondary hover:underline decoration-slate-300 underline-offset-2"
              >
                {c.question}
              </a>
            </h2>
            <blockquote class="mt-3 flex-1 border-l-4 border-bs-primary py-1 pl-3 text-sm leading-relaxed text-slate-700">
              {c.shortAnswer}
            </blockquote>
            <div class="mt-4 flex justify-end border-t border-slate-100 pt-3 text-xs">
              <a
                href={`/quick-reference/${c.slug}/`}
                class="font-medium text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary"
              >
                詳細說明 →
              </a>
            </div>
          </li>
        ))}
      </ul>
    )
  }

</BaseLayout>
