---
// /glossary/ — 術語表（spec §1.1, §3.2；milestones M1-6）。
// 以 term_en 第一字母分組、提供頂部字母索引。
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('glossary');

const sorted = [...all].sort((a, b) =>
  a.data.term_en.localeCompare(b.data.term_en, 'en'),
);

type Entry = (typeof sorted)[number];
const groups = new Map<string, Entry[]>();
for (const entry of sorted) {
  const letter = entry.data.term_en[0]?.toUpperCase() ?? '#';
  const key = /[A-Z]/.test(letter) ? letter : '#';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(entry);
}

const letters = [...groups.keys()].sort();
---

<BaseLayout
  title="術語表"
  description="CA/Browser BR 中譯使用的術語對照表，含英文原文、縮寫與定義。"
  mainMaxWidth="max-w-4xl"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '術語表' }]}
  />

  <header>
    <h1 class="text-2xl font-semibold text-slate-900 sm:text-3xl">術語表</h1>
    <p class="mt-2 text-sm text-slate-600">
      本表收錄翻譯中採用的標準譯名與定義，章節內首次出現之術語會連結至此。
    </p>
  </header>

  {
    letters.length === 0 ? (
      <p class="mt-10 rounded-md border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">
        術語表內容尚未填入，將隨 M2 翻譯進度逐步累積（目標 ≥ 30 條）。
      </p>
    ) : (
      <>
        <nav
          aria-label="字母索引"
          class="mt-6 flex flex-wrap gap-1 rounded-md border border-slate-200 bg-white p-2 text-sm"
        >
          {letters.map((l) => (
            <a
              href={`#letter-${l}`}
              class="inline-flex h-8 w-8 items-center justify-center rounded font-mono font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400"
            >
              {l}
            </a>
          ))}
        </nav>

        <div class="mt-8 space-y-10">
          {letters.map((letter) => (
            <section id={`letter-${letter}`} aria-labelledby={`heading-${letter}`}>
              <h2
                id={`heading-${letter}`}
                class="border-b border-slate-200 pb-1 font-mono text-lg font-semibold text-slate-800"
              >
                {letter}
              </h2>
              <dl class="mt-4 divide-y divide-slate-100">
                {groups.get(letter)!.map((entry) => (
                  <div id={entry.id} class="py-4 sm:grid sm:grid-cols-[14rem_1fr] sm:gap-6">
                    <dt class="font-medium text-slate-900">
                      <div>{entry.data.term_zh}</div>
                      <div class="mt-0.5 text-sm text-slate-500">
                        {entry.data.term_en}
                        {entry.data.abbreviation && (
                          <>
                            {' '}
                            <span class="font-mono text-slate-600">
                              ({entry.data.abbreviation})
                            </span>
                          </>
                        )}
                      </div>
                    </dt>
                    <dd class="mt-2 text-sm leading-relaxed text-slate-700 sm:mt-0">
                      <p class="whitespace-pre-line">{entry.data.definition}</p>
                      {entry.data.first_seen_at && (
                        <p class="mt-2 text-xs text-slate-500">
                          首次出現於：
                          <a
                            href={entry.data.first_seen_at}
                            class="text-slate-700 underline decoration-slate-300 underline-offset-2 hover:decoration-slate-700"
                          >
                            {entry.data.first_seen_at}
                          </a>
                        </p>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>

        <footer class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-500">
          翻譯參考來源：中華電信 HiPKICA CP/CPS v1.1（附錄 1：縮寫及定義、附錄 2：名詞解釋）。
        </footer>
      </>
    )
  }
</BaseLayout>
