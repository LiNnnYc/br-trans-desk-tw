---
// /glossary/ — 術語表總覽（spec §1.1, §3.2）。
// 每詞只顯示「推薦譯名」，點入 /glossary/<slug>/ 看各來源譯名與定義。
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { sourceRefLabel } from '../lib/section';

const all = await getCollection('glossary');

const sorted = [...all].sort((a, b) =>
  a.data.term_en.localeCompare(b.data.term_en, 'en'),
);

type Entry = (typeof sorted)[number];
const groups = new Map<string, Entry[]>();
for (const entry of sorted) {
  const letter = entry.data.term_en[0]?.toUpperCase() ?? '#';
  const key = /[A-Z]/.test(letter) ? letter : '#';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(entry);
}
const letters = [...groups.keys()].sort();

const SOURCE_SHORT: Record<string, string> = {
  BR: 'BR',
  HiPKICA: 'HiPKI CA',
  TWCA: 'TWCA',
  數位發展部: '數發部',
  'BR 翻譯小站': '本站',
};
const srcShort = (s: string) => SOURCE_SHORT[s] ?? s;

// ---------- 縮寫表（acronyms collection）----------
const acronymEntries = (await getCollection('acronyms')).sort((a, b) =>
  a.data.acronym.localeCompare(b.data.acronym, 'en', { sensitivity: 'base' }),
);

// 以 glossary 的 abbreviation 自動對應詞條頁；同縮寫有多個詞條時優先取推薦譯名相同者
const glossaryByAbbr = new Map<string, Entry[]>();
for (const entry of all) {
  const abbr = entry.data.abbreviation;
  if (!abbr) continue;
  if (!glossaryByAbbr.has(abbr)) glossaryByAbbr.set(abbr, []);
  glossaryByAbbr.get(abbr)!.push(entry);
}
const glossaryHref = (acronym: string, zh: string) => {
  const cands = glossaryByAbbr.get(acronym);
  if (!cands?.length) return null;
  const hit = cands.find((c) => c.data.recommended_zh === zh) ?? cands[0];
  return `/glossary/${hit.id}/`;
};

// 英文全稱比較時忽略大小寫、空白與連字號（Fully-Qualified ≈ Fully Qualified）
const normEn = (s?: string) => (s ?? '').toLowerCase().replace(/[\s\-‐]/g, '');

type AcronymSource = (typeof acronymEntries)[number]['data']['sources'][number];
/** 與推薦譯名／英文全稱不同的來源，另列說明文字；相同者只顯示來源標籤 */
const sourceNote = (s: AcronymSource, recZh: string, recEn?: string) => {
  const zhDiff = !!s.term_zh && s.term_zh !== recZh;
  const enDiff = !!s.expansion_en && normEn(s.expansion_en) !== normEn(recEn);
  const parts: string[] = [];
  if (!s.term_zh) parts.push('僅列英文全稱');
  else if (zhDiff) parts.push(s.term_zh);
  if (enDiff) parts.push(s.expansion_en!);
  return parts.length ? parts.join('　') : null;
};
const sourceTitle = (s: AcronymSource) =>
  [s.version, s.ref && sourceRefLabel(s.ref)].filter(Boolean).join('｜') || undefined;
---

<BaseLayout
  title="術語表"
  description="台灣憑證 PKI 與網路基礎建設譯名參考：每個英文術語對照多來源（CA/Browser Forum 基本要求、中華電信 HiPKI CA、TWCA、數位發展部主管法規）的翻譯與定義。"
  mainMaxWidth="max-w-4xl"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '術語表' }]}
  />

  <article class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
    <header>
      <h1 class="text-2xl font-semibold text-slate-900 sm:text-3xl">術語表</h1>
      <p class="mt-2 text-sm text-slate-600">
        台灣憑證 PKI 與網路基礎建設譯名參考。每個英文術語列出本站推薦譯名，點入可比較
        CA/Browser Forum 基本要求、中華電信 HiPKI CA、TWCA、數位發展部主管法規等不同來源的翻譯與定義。頁面下方另附縮寫表。
      </p>
    </header>

    {
      letters.length === 0 ? (
        <p class="mt-10 rounded-md border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">
          術語表內容尚未填入。
        </p>
      ) : (
        <>
          <nav
            aria-label="字母索引"
            class="mt-6 flex flex-wrap items-center gap-1 rounded-md border border-slate-200 bg-white p-2 text-sm"
          >
            {letters.map((l) => (
              <a
                href={`#letter-${l}`}
                class="inline-flex h-8 w-8 items-center justify-center rounded font-mono font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400"
              >
                {l}
              </a>
            ))}
            <span aria-hidden="true" class="mx-1 h-5 w-px bg-slate-200"></span>
            {acronymEntries.length > 0 && (
              <a
                href="#acronyms"
                class="inline-flex h-8 items-center justify-center rounded px-2 font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400"
              >
                縮寫表
              </a>
            )}
            <a
              href="#rfc-2119"
              class="inline-flex h-8 items-center justify-center rounded px-2 font-mono font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400"
            >
              RFC 2119
            </a>
          </nav>

          <div class="mt-8 space-y-10">
            {letters.map((letter) => (
              <section id={`letter-${letter}`} aria-labelledby={`heading-${letter}`}>
                <h2
                  id={`heading-${letter}`}
                  class="border-b border-slate-200 pb-1 font-mono text-lg font-semibold text-slate-800"
                >
                  {letter}
                </h2>
                <dl class="mt-4 divide-y divide-slate-100">
                  {groups.get(letter)!.map((entry) => {
                    const recDef = entry.data.recommended_definition;
                    return (
                      <div class="py-4 sm:grid sm:grid-cols-[16rem_1fr] sm:gap-x-12">
                        <dt class="font-medium text-slate-900 sm:pr-4">
                          <a
                            href={`/glossary/${entry.id}/`}
                            class="text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary"
                          >
                            {entry.data.recommended_zh}
                          </a>
                          <div class="mt-0.5 text-sm text-slate-500">
                            {entry.data.term_en}
                            {entry.data.abbreviation && (
                              <span class="ml-1 font-mono text-slate-600">
                                ({entry.data.abbreviation})
                              </span>
                            )}
                          </div>
                        </dt>
                        <dd class="mt-2 text-sm leading-relaxed text-slate-700 sm:mt-0">
                          <p class="whitespace-pre-line">{recDef}</p>
                          <p class="mt-2 flex flex-wrap items-center gap-1 text-xs text-slate-500">
                            <span>來源：</span>
                            {entry.data.sources.map((s) => (
                              <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 font-medium text-slate-500">
                                {srcShort(s.source)}
                              </span>
                            ))}
                          </p>
                        </dd>
                      </div>
                    );
                  })}
                </dl>
              </section>
            ))}
          </div>

          {acronymEntries.length > 0 && (
            <section id="acronyms" aria-labelledby="heading-acronyms" class="mt-10">
              <h2
                id="heading-acronyms"
                class="border-b border-slate-200 pb-1 text-lg font-semibold text-slate-800"
              >
                縮寫表
              </h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                各來源對同一縮寫的中文名稱與英文全稱。與推薦譯名相同的來源只列標籤，不同者另列該來源的寫法；已收錄於術語表的縮寫可點入查看定義。
              </p>
              <div class="mt-4 overflow-x-auto rounded-md border border-slate-200">
                <table class="w-full text-sm">
                  <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
                    <tr>
                      <th scope="col" class="px-4 py-2 font-semibold">縮寫</th>
                      <th scope="col" class="px-4 py-2 font-semibold">全稱</th>
                      <th scope="col" class="px-4 py-2 font-semibold">來源</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 text-slate-700">
                    {acronymEntries.map((a) => {
                      const d = a.data;
                      const href = glossaryHref(d.acronym, d.recommended_zh);
                      const same = d.sources.filter((s) => !sourceNote(s, d.recommended_zh, d.expansion_en));
                      const diff = d.sources.filter((s) => sourceNote(s, d.recommended_zh, d.expansion_en));
                      return (
                        <tr id={`acronym-${a.id}`} class="align-top">
                          <td class="whitespace-nowrap px-4 py-3 font-mono font-semibold text-slate-900">
                            {d.acronym}
                          </td>
                          <td class="min-w-[14rem] px-4 py-3">
                            {href ? (
                              <a
                                href={href}
                                class="font-medium text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary"
                              >
                                {d.recommended_zh}
                              </a>
                            ) : (
                              <span class="font-medium text-slate-900">{d.recommended_zh}</span>
                            )}
                            {d.expansion_en && (
                              <div lang="en" class="mt-0.5 text-slate-500">{d.expansion_en}</div>
                            )}
                          </td>
                          <td class="min-w-[12rem] px-4 py-3 text-xs text-slate-500">
                            {same.length > 0 && (
                              <div class="flex flex-wrap gap-1">
                                {same.map((s) => (
                                  <span
                                    title={sourceTitle(s)}
                                    class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 font-medium text-slate-500"
                                  >
                                    {srcShort(s.source)}
                                  </span>
                                ))}
                              </div>
                            )}
                            {diff.map((s) => (
                              <div class={same.length > 0 ? 'mt-1.5' : ''}>
                                <span
                                  title={sourceTitle(s)}
                                  class="mr-1 inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 font-medium text-slate-500"
                                >
                                  {srcShort(s.source)}
                                </span>
                                <span class="text-slate-700">{sourceNote(s, d.recommended_zh, d.expansion_en)}</span>
                              </div>
                            ))}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          <section id="rfc-2119" aria-labelledby="heading-rfc-2119" class="mt-10">
            <h2
              id="heading-rfc-2119"
              class="border-b border-slate-200 pb-1 font-mono text-lg font-semibold text-slate-800"
            >
              RFC 2119
            </h2>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              CA/Browser Forum 基本要求全文使用 <a href="https://datatracker.ietf.org/doc/html/rfc2119" target="_blank" rel="noopener noreferrer" class="text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary">RFC 2119</a> 定義的規範詞表達義務強度。本翻譯統一採下列譯名（與中華電信 HiPKI CA、TWCA 業界慣例一致）：
            </p>
            <div class="mt-4 overflow-x-auto rounded-md border border-slate-200">
              <table class="w-full text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
                  <tr>
                    <th scope="col" class="px-4 py-2 font-semibold">英文（同義詞）</th>
                    <th scope="col" class="px-4 py-2 font-semibold">強度</th>
                    <th scope="col" class="px-4 py-2 font-semibold">翻譯</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                  <tr>
                    <td class="px-4 py-3 font-mono"><strong>MUST</strong> = <strong>SHALL</strong> = REQUIRED</td>
                    <td class="px-4 py-3">絕對要求</td>
                    <td class="px-4 py-3 font-medium text-slate-900">應</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-mono"><strong>MUST NOT</strong> = <strong>SHALL NOT</strong></td>
                    <td class="px-4 py-3">絕對禁止</td>
                    <td class="px-4 py-3 font-medium text-slate-900">不得</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-mono"><strong>SHOULD</strong> = RECOMMENDED</td>
                    <td class="px-4 py-3">強烈建議</td>
                    <td class="px-4 py-3 font-medium text-slate-900">宜</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-mono"><strong>SHOULD NOT</strong> = NOT RECOMMENDED</td>
                    <td class="px-4 py-3">強烈不建議</td>
                    <td class="px-4 py-3 font-medium text-slate-900">不宜</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-mono"><strong>MAY</strong> = OPTIONAL</td>
                    <td class="px-4 py-3">可選</td>
                    <td class="px-4 py-3 font-medium text-slate-900">得</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="mt-3 text-xs text-slate-500 leading-relaxed">
              章節內文中規範詞以粗體標示，例如「<strong>應（MUST）</strong>」、「<strong>不得（MUST NOT）</strong>」。括號內保留英文原詞便於與 cabforum.org 原文對照；MUST 與 SHALL 在 RFC 2119 中完全等同，譯文一律譯為「應」。
            </p>
          </section>

          <footer class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-500">
            <p class="mb-2">翻譯參考來源：</p>
            <ul class="list-disc space-y-1 pl-6">
              <li>CA/Browser Forum 基本要求（§1.6 名詞定義與縮寫）</li>
              <li>中華電信 HiPKI CA CP/CPS v1.1／v1.2（附錄 1：縮寫及定義、附錄 2：名詞解釋）</li>
              <li>臺灣網路認證 TWCA Global CPS v3.2（附錄一：詞彙）</li>
              <li>數位發展部主管法規：電子簽章法、數位簽章憑證實務作業基準應載明事項</li>
              <li>本站彙整：上述來源皆未收錄的詞，由本站整理公開資料擬定</li>
            </ul>
          </footer>
        </>
      )
    }
  </article>
</BaseLayout>
