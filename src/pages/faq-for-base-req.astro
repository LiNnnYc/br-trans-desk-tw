---
// /faq-for-base-req/ — cabforum.org「FAQ for Baseline Requirements」繁體中文翻譯。
//
// 譯文放在 src/md/faq-for-base-req.md（Style A，同 src/content/br/*.md 慣例）。
//
// ⚠️ 原頁面撰於 2013 年且上游未再更新，內容有多處已與現行《基本要求》不符
// （憑證有效期、內部名稱淘汰期限、第 9.3.4 節、CP OID 清單）。譯文逐處加了
// 「編按」指向現行條文，頁首另有整體提醒——兩者都是本站的補充，不是原文的一部分。
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BrSidebarSubmenu from '../components/BrSidebarSubmenu.astro';
import { Content } from '../md/faq-for-base-req.md';

const ORIGINAL_URL = 'https://cabforum.org/working-groups/server/baseline-requirements/faq/';
const ORIGINAL_DATE = '2013-09-04';
const LAST_SYNCED = '2026-08-20';
---

<BaseLayout
  title="《基本要求》官方 FAQ"
  description="CA/Browser Forum 官方網站「FAQ for Baseline Requirements」頁面之非官方繁體中文翻譯，並標註與現行《基本要求》不符之處。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '《基本要求》官方 FAQ' }]}
  />

  <article class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
    <header class="border-b border-slate-200 pb-4">
      <h1 class="font-serif-tc text-2xl font-bold text-slate-900 sm:text-3xl leading-tight">
        《基本要求》官方常見問答
      </h1>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        CA/Browser Forum 官方網站「FAQ for Baseline Requirements」頁面之非官方繁體中文翻譯。
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <a
          href={ORIGINAL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-500 hover:bg-slate-50"
          aria-label="在新分頁開啟 cabforum.org 原文：FAQ for Baseline Requirements"
        >
          <span aria-hidden="true">↗</span>
          <span>原文</span>
        </a>
      </div>
    </header>

    <aside
      class="mt-6 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900"
      aria-label="內容時效提醒"
    >
      <p class="font-semibold">⚠️ 原頁面內容已過時</p>
      <p class="mt-1.5">
        本 FAQ 原文標示日期為 <span class="font-mono">{ORIGINAL_DATE}</span>，CA/Browser Forum
        其後未再更新，其中關於<strong>憑證有效期</strong>、<strong>內部名稱淘汰期限</strong>、
        <strong>條號引用</strong>與 <strong>CP OID 清單</strong>的敘述，均已與現行《基本要求》不符。
        譯文中以「編按」標出並指向現行條文；<strong>「編按」為本站補充，不屬於原文</strong>。
        對外引用請以<a href="/server-cert-br/" class="underline decoration-amber-400 underline-offset-2 hover:decoration-amber-700">現行《基本要求》規定</a>為準。
      </p>
    </aside>

    <div class="clause-body mt-6">
      <Content />
    </div>

    <footer class="mt-8 border-t border-slate-200 pt-4 text-xs text-slate-500">
      <dl class="grid grid-cols-1 gap-y-1 sm:grid-cols-[6rem_1fr]">
        <dt class="font-medium text-slate-600">原文</dt>
        <dd>
          <a
            href={ORIGINAL_URL}
            class="text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary break-all"
            target="_blank"
            rel="noopener noreferrer">{ORIGINAL_URL}</a>
        </dd>
        <dt class="font-medium text-slate-600">原文日期</dt>
        <dd><time datetime={ORIGINAL_DATE}>{ORIGINAL_DATE}</time></dd>
        <dt class="font-medium text-slate-600">最後同步</dt>
        <dd><time datetime={LAST_SYNCED}>{LAST_SYNCED}</time></dd>
      </dl>
    </footer>
  </article>

  <Fragment slot="sidebar">
    <BrSidebarSubmenu currentPath="/faq-for-base-req/" />
  </Fragment>
</BaseLayout>
