---
// /changelog/ — 版本歷程。M1-3 階段為最小 stub（讓徽章點擊不 404）。
// M1-8 補上正式內容：時間序列表（Git tag 或手動 markdown）。
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../config/site';

const { version, syncStatus, lastSyncedAt, behindCount } = siteConfig.upstream;
---

<BaseLayout title="版本歷程" description="本站翻譯與 CA/Browser Forum 原文版本同步紀錄。">
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '版本歷程' }]}
  />

  <h1 class="text-2xl font-semibold text-slate-900 sm:text-3xl">版本歷程</h1>

  <dl class="mt-6 grid gap-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2">
    <div>
      <dt class="text-xs font-semibold tracking-wider text-slate-500 uppercase">對應原文版本</dt>
      <dd class="mt-1 text-slate-900">{version === 'tbd' ? '版本待定' : version}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold tracking-wider text-slate-500 uppercase">同步狀態</dt>
      <dd class="mt-1 text-slate-900">
        {syncStatus === 'synced' && '已同步'}
        {syncStatus === 'behind' && `落後 ${behindCount} 個 Ballot`}
        {syncStatus === 'pending' && '建置中'}
      </dd>
    </div>
    <div>
      <dt class="text-xs font-semibold tracking-wider text-slate-500 uppercase">最後更新</dt>
      <dd class="mt-1 text-slate-900">{lastSyncedAt ?? '—'}</dd>
    </div>
  </dl>

  <p class="mt-6 text-sm text-slate-600">
    詳細的版本歷程時間軸將於 M1-8 補齊（每次 Ballot 跟進與翻譯更新會記錄一筆）。
  </p>
</BaseLayout>
