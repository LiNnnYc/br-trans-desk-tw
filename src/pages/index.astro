---
import '../styles/global.css';

const contactEmail = 'linnnyc5252@gmail.com';
// TODO(M0-1): repo 建立後填入實際 URL
const repoUrl = '#TODO-github-repo';
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="CA/Browser Forum Server Certificate Baseline Requirements 的非官方繁體中文翻譯（建置中）。"
    />
    <title>CA/Browser BR 中文化｜Coming Soon</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-4 sm:px-8">
          <span class="text-sm font-medium tracking-wide text-slate-600">
            CA/Browser BR 中文化
          </span>
          <span
            class="rounded-full border border-amber-300 bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-800"
          >
            Coming Soon
          </span>
        </div>
      </header>

      <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-10 sm:px-8 sm:py-16">
        <h1 class="text-3xl font-semibold leading-tight text-slate-900 sm:text-4xl">
          CA/Browser Forum<br />Server Cert Baseline Requirements<br />
          <span class="text-slate-700">繁體中文翻譯（建置中）</span>
        </h1>

        <p class="mt-6 text-base leading-relaxed text-slate-700 sm:text-lg">
          長期以來 CA/Browser Forum 的 Server Certificate Baseline Requirements
          沒有公開的繁體中文版本。本站是由社群維護的<strong class="font-semibold">非官方</strong>翻譯，
          目標是讓台灣 CA 從業人員、購買憑證的企業窗口、與資安／法務人員
          在面對「為什麼申請憑證這麼麻煩、為什麼憑證效期越來越短」這類問題時，
          能有可引用的中文翻譯內容。
        </p>

        <section class="mt-10 rounded-lg border border-slate-200 bg-white p-5 sm:p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
            預計時程
          </h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-700 sm:text-base">
            <li>
              <span class="font-medium text-slate-900">M0–M1</span>
              ｜站台骨架、術語表、版本治理機制
            </li>
            <li>
              <span class="font-medium text-slate-900">M2</span>
              ｜Baseline Requirements 主文件翻譯（約 8–10 週）
            </li>
            <li>
              <span class="font-medium text-slate-900">M3</span>
              ｜附屬頁面（About、Certificate Contents、FAQ）翻譯
            </li>
            <li>
              <span class="font-medium text-slate-900">M4</span>
              ｜公開 Beta、進入跟進維運期
            </li>
          </ul>
          <p class="mt-3 text-xs text-slate-500">
            單人作業，時程估算為相對長度而非絕對日期；實際進度以 changelog 與 GitHub 進度為準。
          </p>
        </section>

        <section class="mt-8 grid gap-4 sm:grid-cols-2">
          <a
            href={`mailto:${contactEmail}`}
            class="rounded-lg border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:bg-slate-50"
          >
            <div class="text-sm font-semibold text-slate-900">勘誤與聯絡</div>
            <div class="mt-1 break-all text-sm text-slate-600">{contactEmail}</div>
          </a>
          <a
            href={repoUrl}
            class="rounded-lg border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:bg-slate-50"
          >
            <div class="text-sm font-semibold text-slate-900">GitHub Repo</div>
            <div class="mt-1 text-sm text-slate-600">原始碼、Issue、PR（建置中）</div>
          </a>
        </section>
      </main>

      <footer class="border-t border-slate-200 bg-white">
        <div
          class="mx-auto max-w-3xl space-y-2 px-5 py-6 text-xs leading-relaxed text-slate-600 sm:px-8 sm:text-sm"
        >
          <p>
            本站為 CA/Browser Forum Baseline Requirements 的<strong class="font-semibold"
              >非官方中文翻譯</strong
            >，由社群維護。
          </p>
          <p>
            發生爭議時以 <strong class="font-semibold">CA/Browser Forum 英文原文為準</strong
            >。本翻譯不構成法律意見。
          </p>
          <p>
            原文採 <a
              href="https://creativecommons.org/licenses/by/4.0/"
              class="underline hover:text-slate-900"
              rel="noopener noreferrer"
              target="_blank">CC BY 4.0</a
            > 授權；本翻譯亦採 CC BY 4.0 釋出。
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
