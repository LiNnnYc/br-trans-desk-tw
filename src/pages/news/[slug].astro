---
// /news/<slug>/ — 更新消息詳細頁。
// header 放「日期 + 分類徽章 + 標題」，內文走 .clause-body（與快速參考詳細頁同一套排版），
// 最下方給回列表的連結。摘要（summary）只用在列表與 meta description，詳細頁不重複顯示。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { newsCategoryClass, sortNews, toIsoDate } from '../../lib/news';

export async function getStaticPaths() {
  const all = sortNews(await getCollection('news'));
  return all.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const iso = toIsoDate(d.date);
---

<BaseLayout title={d.title} description={d.summary} mainMaxWidth="max-w-4xl">
  <Breadcrumb
    slot="breadcrumb"
    items={[
      { label: '首頁', href: '/' },
      { label: '更新消息', href: '/news/' },
      { label: d.title },
    ]}
  />

  <article class="cabf-card rounded border border-slate-200 bg-white p-5 sm:p-7">
    <header class="border-b border-slate-200 pb-5">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <time datetime={iso} class="font-mono text-xs text-slate-500">{iso}</time>
        <span
          class={`inline-flex shrink-0 rounded border px-2 py-0.5 text-xs ${newsCategoryClass(d.category)}`}
        >
          {d.category}
        </span>
      </div>
      <h1 class="mt-4 font-serif-tc text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">
        {d.title}
      </h1>
    </header>

    <div class="clause-body mt-6">
      <Content />
    </div>

    <footer class="mt-8 border-t border-slate-200 pt-4 text-sm">
      <a
        href="/news/"
        class="text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary"
      >
        ← 回更新消息列表
      </a>
    </footer>
  </article>
</BaseLayout>
