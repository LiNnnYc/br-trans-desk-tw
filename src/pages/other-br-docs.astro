---
// /other-br-docs/ — cabforum.org BR「Documents」頁（各版本 PDF／修訂對照／投票案索引）
// 的繁體中文版（spec §1.1 的「其他相關 BR 文件中譯」）。
//
// 內容由 scripts/build_other_br_docs.py 從 web-spec-doc/BR_側邊欄/documents_index.md
// 產生為 src/md/other-br-docs.md。這頁是**連結索引**而非條文散文，故不採 Style A
// 中英對照（英文側與中文側會幾乎一模一樣）；文件名稱與投票案編號是識別碼，保留
// 英文原樣，翻譯的是外圍語句。BR 升版後重抓原文再跑一次腳本即可更新。
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BrSidebarSubmenu from '../components/BrSidebarSubmenu.astro';
import { siteConfig } from '../config/site';
import { Content } from '../md/other-br-docs.md';

const ORIGINAL_URL =
  'https://cabforum.org/working-groups/server/baseline-requirements/documents/';
const LAST_SYNCED = '2026-08-20';
// 版本一律由 src/config/br-versions.ts 推導（見 src/lib/version.ts），必然是具體
// 版本號——曾有的 'tbd' 佔位狀態已不存在，故不再做「版本待定」分支。
const { version } = siteConfig.upstream;
const versionLabel = `v${version}`;
---

<BaseLayout
  title="官方文件與歷史版本（原文）"
  description="列出 CA/Browser Forum TLS Baseline Requirements 各版本官方文件（原文）、修訂對照（原文）與對應投票案。"
>
  <Breadcrumb
    slot="breadcrumb"
    items={[{ label: '首頁', href: '/' }, { label: '官方文件與歷史版本（原文）' }]}
  />

  <article class="cabf-card bg-white border border-slate-200 rounded p-5 sm:p-7">
    <header class="border-b border-slate-200 pb-4">
      <h1 class="font-serif-tc text-2xl font-bold text-slate-900 sm:text-3xl leading-tight">
        官方文件與歷史版本（原文）
      </h1>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        CA/Browser Forum 官方 Documents 頁面之文件（原文）列表：TLS Baseline Requirements
        各版本 PDF、修訂對照版（redlined），以及通過該版本的投票案。
        <strong>所有連結均指向 cabforum.org 的官方文件</strong>，文件本身為英文。
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <a
          href={ORIGINAL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-500 hover:bg-slate-50"
          aria-label="在新分頁開啟 cabforum.org 原文：Baseline Requirements Documents"
        >
          <span aria-hidden="true">↗</span>
          <span>原文</span>
        </a>
        <a
          href="/server-cert-br/"
          class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-500 hover:bg-slate-50"
        >
          <span>本站翻譯（{versionLabel}）</span>
        </a>
      </div>
    </header>

    <aside
      class="mt-6 rounded-md border border-sky-300 bg-sky-50 p-4 text-sm leading-relaxed text-sky-900"
      aria-label="本站對應版本說明"
    >
      本站翻譯對應 <strong>TLS BR {versionLabel}</strong>。官方現行版本請見下方「現行版本」一節——
      若兩者不同，代表官方已發布新版本而本站尚未跟進，以《基本要求》官方原文為準。
    </aside>

    <div class="clause-body mt-6">
      <Content />
    </div>

    <footer class="mt-8 border-t border-slate-200 pt-4 text-xs text-slate-500">
      <dl class="grid grid-cols-1 gap-y-1 sm:grid-cols-[6rem_1fr]">
        <dt class="font-medium text-slate-600">原文</dt>
        <dd>
          <a
            href={ORIGINAL_URL}
            class="text-bs-secondary underline decoration-slate-300 underline-offset-2 hover:decoration-bs-secondary break-all"
            target="_blank"
            rel="noopener noreferrer">{ORIGINAL_URL}</a>
        </dd>
        <dt class="font-medium text-slate-600">最後同步</dt>
        <dd><time datetime={LAST_SYNCED}>{LAST_SYNCED}</time></dd>
      </dl>
      <p class="mt-3 text-[11px] leading-relaxed text-slate-500">
        ⚠️ 本頁僅為官方文件列表之中文顯示；文件內容以 CA/Browser Forum 英文原文為準。
      </p>
    </footer>
  </article>

  <Fragment slot="sidebar">
    <BrSidebarSubmenu currentPath="/other-br-docs/" />
  </Fragment>
</BaseLayout>
