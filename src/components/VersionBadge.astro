---
// spec §4.1 — 版本狀態徽章。
// 兩種外觀：
//   variant="light"（預設）— 白底淺色，原本給 banner 右上用；**2026-09-20 起沒有呼叫端**
//     （徽章改成只在首頁顯示，banner 那顆已移除），保留以便日後要放回亮色背景時直接用
//   variant="dark" — 透明深底，給漢堡選單裡的暗色背景用
//   variant="plain" — 無外框無底色，給側欄 widget 用（外層卡片已經有框，不要框中框）
// 內容：Ballot 標籤 + 版本 + 同步狀態指示燈 + 原文發布日。
// 「完整版本歷程 →」連結已於 2026-09-19 依使用者指示移除（徽章不再可點）；
// /changelog/ 的入口只留在《基本要求》側邊選單的「本站翻譯版本歷程」。
import { siteConfig, type SyncStatus } from '../config/site';
import { upstream as upstreamLatest } from '../lib/version';

interface Props {
  variant?: 'light' | 'dark' | 'plain';
}

const { variant = 'light' } = Astro.props;

const { version, syncStatus, lastSyncedAt } = siteConfig.upstream;

// 落後時要把「上游已經到哪一版」講出來——只說「落後」會讓人不知道該去看哪個版本。
const statusLabel: Record<SyncStatus, string> = {
  pending: '建置中',
  synced: '已同步',
  behind: upstreamLatest.version ? `上游 v${upstreamLatest.version}` : '落後',
};

const statusDot: Record<SyncStatus, string> = {
  synced: 'bg-emerald-500',
  behind: 'bg-amber-500',
  pending: 'bg-slate-400',
};

// 版本必然是具體版本號（由 br-versions.ts 推導），不再有 'tbd' 佔位狀態。
const versionLabel = `v${version.replace(/^v/, '')}`;
// 顯示的是**該版原文的發布日**（cabforum 於 GitHub 釋出的 BR.md 標頭 date），
// 不是本站的翻譯日期——客服對照原文時要看的是這個。徽章空間放不下標籤，
// 以 title 補上語意，免得被讀成「最後同步日」。
const dateLabel = lastSyncedAt;

const isDark = variant === 'dark';

const wrapperCls =
  variant === 'dark'
    ? 'block text-xs text-slate-300'
    : variant === 'plain'
      ? 'block text-xs text-slate-600'
      : 'block rounded border border-slate-300 bg-white px-3 py-2 text-xs text-slate-600';
const labelCls = isDark
  ? 'font-semibold uppercase tracking-wide text-slate-400'
  : 'font-semibold uppercase tracking-wide text-slate-500';
const versionCls = isDark
  ? 'font-mono font-bold text-bs-primary'
  : 'font-mono font-bold text-bs-primary';
const statusTextCls: Record<SyncStatus, string> = isDark
  ? {
      synced: 'text-emerald-300 font-medium',
      behind: 'text-amber-300 font-medium',
      pending: 'text-slate-300 font-medium',
    }
  : {
      synced: 'text-emerald-700 font-medium',
      behind: 'text-amber-800 font-medium',
      pending: 'text-slate-700 font-medium',
    };
const dateTextCls = isDark ? 'text-slate-500' : 'text-slate-500';
---

<div class={wrapperCls}>
  <div class="flex items-baseline justify-between gap-3">
    <span class={labelCls}>TLS BR</span>
    <span class={versionCls}>{versionLabel}</span>
  </div>
  <div class="mt-1 flex items-center gap-1.5">
    <span class:list={['inline-block h-2 w-2 rounded-full', statusDot[syncStatus]]}></span>
    <span class={statusTextCls[syncStatus]}>{statusLabel[syncStatus]}</span>
    {
      dateLabel && (
        <span class={dateTextCls}>
          · <time datetime={dateLabel} title="原文發布日">{dateLabel}</time>
        </span>
      )
    }
  </div>
</div>
