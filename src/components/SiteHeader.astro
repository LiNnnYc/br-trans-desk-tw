---
// spec §1.2 頁首：banner（站台 logo + 標語）+ 全寬深色 navbar。
// 2026-09-22 起 banner 不再顯示站名文字，改由 logo 承擔（見下方註解）。
// 行動端漢堡 collapse 內含搜尋輸入、主選單、Ballot 摘要。
// 中英對照 toggle 改放至章節頁工具列（M2 時接 Quotable 區）；本元件僅維持站台導覽。
// 搜尋按鈕（桌面 + 漢堡內輸入）皆透過 window.__openSearchModal 開啟 Pagefind modal（M1-9）。
import VersionBadge from './VersionBadge.astro';
import BrSidebarSubmenu from './BrSidebarSubmenu.astro';

const navItems = [
  { label: '首頁', href: '/' },
  { label: '基本要求', href: '/server-cert-br/' },
  { label: '術語表', href: '/glossary/' },
  { label: '快速參考', href: '/quick-reference/' },
  { label: '關於', href: '/about-this-site/' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// 規格 web-spec-doc/server-cert-br樣式變更.txt：
// 只在 /server-cert-br 子頁面才把《基本要求》子選單整合進漢堡選單。
const showBrSubmenuInMobile = currentPath.startsWith('/server-cert-br');

// 版本徽章 2026-09-20 依使用者指示**只在首頁顯示**：
//   桌機（lg+）— 首頁側欄的 SyncWidget（SyncWidget.astro）；banner 右上那顆已整個移除。
//   手機（<lg）— 首頁漢堡選單內的 variant="dark"；側欄在 <lg 不顯示，靠這顆補上。
// 其他頁面兩處都不顯示。⚠️ 這代表 VersionBadge 的 variant="light" 目前沒有呼叫端。
const isHome = currentPath === '/';
---

<header>
  <div class="hidden lg:block h-4"></div>

  <div class="bg-white shadow-sm border-t-4 border-bs-primary">
    {/* 2026-09-22：原本的藍色「BR」方塊換成站台 logo（public/br-logo.svg，見 scripts/build_logo.py，
        由 web-spec-doc/BR_logo/BR_Desk_Logo_2.png 這張扁平風原圖按色分層描邊而成）。
        上下內距配合 logo 比例（viewBox 760×437）加大，讓 logo 有呼吸空間；
        站名（siteConfig.name）依使用者指示移除，只留「Web PKI 繁中資訊站」，
        並以 items-center 對齊 logo 中心線。 */}
    <div class="px-4 py-4 lg:py-5 flex items-center justify-between gap-4">
      <a href="/" class="inline-flex items-center gap-3 lg:gap-5 min-w-0">
        <img
          src="/br-logo.svg"
          width="760"
          height="437"
          alt="BR 翻譯小站"
          class="h-24 lg:h-28 w-auto shrink-0"
        />
        <span class="hidden sm:block h-8 lg:h-12 w-px bg-slate-200 shrink-0"></span>
        <span class="font-serif-tc text-sm sm:text-base lg:text-xl text-slate-700 leading-snug min-w-0">
          Web PKI 繁中資訊站
        </span>
      </a>

    </div>
  </div>
</header>

{/* 行動裝置上 sticky 於頂端（比照 cabforum.org / Mockup A）；
    桌面（lg）保持 static，仍嵌於 1140 container 下方。
    放在 <header> 之外、與主內容平行，sticky 的 containing block 才會是
    BaseLayout 的長 flex column，而非 shrink-wrap 的 header。 */}
<div class="sticky top-0 z-40 lg:static bg-bs-dark border-b-4 border-bs-primary shadow-sm lg:shadow-none">
  {/* lg:pb-0 —— 桌面版拿掉 nav 的下內距，讓選單項的 3px 底線直接貼上外層 div 的
      4px border-b（同為 bs-primary），兩條藍線接成一塊、不留深色縫隙。
      手機版仍保留 py-1：那裡的 active 標記走左側框線（border-l），與底線無關。 */}
  <nav class="text-slate-200 px-3 py-1 lg:pb-0">
      <div class="flex flex-wrap items-center">
        <button
          id="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="navbar-collapse"
          aria-label="開啟選單"
          class="lg:hidden inline-flex items-center justify-center rounded border border-slate-500 p-1.5 my-1"
        >
          <svg
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
          </svg>
        </button>
        <button
          id="menu-btn-label"
          type="button"
          aria-controls="navbar-collapse"
          aria-hidden="true"
          tabindex="-1"
          class="lg:hidden ml-3 my-1 text-sm text-slate-200 hover:text-white"
        >
          ← 開啟選單
        </button>

        <div
          id="navbar-collapse"
          class="hidden lg:flex w-full lg:w-auto lg:flex-1 flex-col lg:flex-row lg:items-center gap-1 lg:gap-0"
        >
          <button
            id="mobile-search-trigger"
            type="button"
            class="lg:hidden mt-5 mb-4 flex order-first w-full items-center gap-2 rounded border border-slate-500 bg-black/30 px-4 py-3 text-sm text-slate-300 hover:bg-black/50 hover:text-white"
            aria-label="開啟搜尋"
          >
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"
                ></path>
              </svg>
              <span>搜尋翻譯、術語、章節編號…</span>
            </button>

            <div class="lg:hidden mx-2 mb-2 border-t border-slate-700"></div>

            {showBrSubmenuInMobile && (
              <div class="lg:hidden">
                <BrSidebarSubmenu currentPath={currentPath} variant="mobile" />
                <div class="mx-2 mt-2 mb-2 border-t border-slate-700"></div>
              </div>
            )}

            <ul class="flex flex-col lg:flex-row text-sm">
              {
                navItems.map((item) => {
                  const active = isActive(item.href);
                  const baseCls =
                    'block px-3 py-3 lg:py-2 font-normal border-l-[3px] lg:border-l-0 lg:border-b-4';
                  const activeCls =
                    'text-white border-bs-primary bg-white/5';
                  const idleCls =
                    'border-transparent text-slate-300 hover:text-white hover:bg-white/5';
                  return (
                    <li>
                      <a
                        href={item.href}
                        aria-current={active ? 'page' : undefined}
                        class={`${baseCls} ${active ? activeCls : idleCls}`}
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>

            {
              isHome && (
                <>
                  <div class="lg:hidden mx-2 mt-3 border-t border-slate-700" />

                  <div class="lg:hidden mx-2 mt-4 mb-3 rounded border border-slate-600 bg-black/20 px-3 py-3 text-xs text-slate-300">
                    <VersionBadge variant="dark" />
                  </div>
                </>
              )
            }
          </div>

          <button
            id="open-search"
            type="button"
            aria-label="搜尋（Ctrl/⌘ + K）"
            title="搜尋（Ctrl/⌘ + K）"
            class="hidden lg:inline-flex ml-auto items-center px-3 py-2 text-slate-300 hover:text-white"
          >
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"
              ></path>
            </svg>
          </button>
        </div>
      </nav>
  </div>

<div class="hidden lg:block h-6"></div>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const collapse = document.getElementById('navbar-collapse');
  const menuLabel = document.getElementById('menu-btn-label');
  const setMenuState = (opened: boolean) => {
    if (!menuBtn) return;
    menuBtn.setAttribute('aria-expanded', opened ? 'true' : 'false');
    menuBtn.setAttribute('aria-label', opened ? '收合選單' : '開啟選單');
    if (menuLabel) menuLabel.textContent = opened ? '← 關閉選單' : '← 開啟選單';
  };
  const toggleMenu = () => {
    if (!collapse) return;
    const opened = collapse.classList.toggle('hidden') === false;
    setMenuState(opened);
  };
  menuBtn?.addEventListener('click', toggleMenu);
  menuLabel?.addEventListener('click', toggleMenu);

  // M1-9：兩個搜尋入口（桌面 + 漢堡內）皆觸發 SearchModal
  type OpenSearchWindow = Window & { __openSearchModal?: () => void };
  const openSearch = () => (window as OpenSearchWindow).__openSearchModal?.();
  document.getElementById('open-search')?.addEventListener('click', openSearch);
  document.getElementById('mobile-search-trigger')?.addEventListener('click', () => {
    collapse?.classList.add('hidden');
    setMenuState(false);
    openSearch();
  });
</script>
