---
// spec §1.2 頁首：站名、版本徽章、中英對照 toggle、搜尋框。
// 中英對照 toggle 行為見 spec §4.2，狀態存 localStorage('bilingual-mode')。
// 搜尋為占位（disabled），實際 Pagefind 整合由 M1-9 接上。
import { siteConfig } from '../config/site';
import VersionBadge from './VersionBadge.astro';
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 py-3 md:flex-row md:items-center md:gap-6 md:py-4">
      <a
        href="/"
        class="flex items-center gap-2 text-base font-semibold text-slate-900 hover:text-slate-700 md:text-lg"
      >
        <span class="hidden md:inline">{siteConfig.name}</span>
        <span class="md:hidden">{siteConfig.shortName}</span>
      </a>

      <div class="flex-1 md:px-4">
        <label class="relative block">
          <span class="sr-only">搜尋</span>
          <input
            type="search"
            disabled
            placeholder="搜尋（即將推出）"
            aria-label="搜尋（即將推出）"
            class="w-full rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm text-slate-500 placeholder-slate-400 focus:outline-none disabled:cursor-not-allowed"
          />
        </label>
      </div>

      <div class="flex items-center justify-between gap-3 md:justify-end">
        <VersionBadge />
        <button
          type="button"
          id="bilingual-toggle"
          aria-pressed="false"
          aria-label="切換中英對照顯示"
          title="切換中英對照顯示"
          class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:border-slate-400 hover:bg-slate-50 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white"
        >
          <span>中</span>
          <span class="opacity-40">/</span>
          <span>EN</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // spec §4.2 — 中英對照 toggle。
  // 初始狀態由 BaseLayout <head> 的 inline script 套用至 documentElement（避免 FOUC）；
  // 這支 script 負責同步按鈕 aria-pressed 與處理點擊。
  const STORAGE_KEY = 'bilingual-mode';
  const root = document.documentElement;
  const btn = document.getElementById('bilingual-toggle');

  function syncButton() {
    if (!btn) return;
    btn.setAttribute('aria-pressed', root.classList.contains('show-bilingual') ? 'true' : 'false');
  }

  syncButton();

  btn?.addEventListener('click', () => {
    const on = root.classList.toggle('show-bilingual');
    try {
      localStorage.setItem(STORAGE_KEY, on ? 'on' : 'off');
    } catch (_) {
      /* localStorage 不可用時不持久化，僅維持本次切換 */
    }
    syncButton();
  });
</script>
