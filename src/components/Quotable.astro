---
// spec §4.3 — 段落級引用：hover 時於段落右側顯示複製按鈕。
// 包裹一個段落（或可被引用的最小單位），按鈕在 group-hover / focus-within 時顯現。
import { buildCitation } from '../lib/citation';
import { siteConfig } from '../config/site';

interface Props {
  sectionId: string;
  title: string;
  /** 段落純文字（複製到剪貼簿的內容） */
  body: string;
  originalUrl: string;
  originalVersion: string;
}

const { sectionId, title, body, originalUrl, originalVersion } = Astro.props;

const citation = buildCitation({
  sectionId,
  title,
  body,
  originalUrl,
  originalVersion,
  siteUrl: siteConfig.siteUrl,
});
---

<div class="quotable group relative">
  <slot />
  <button
    type="button"
    class="citation-copy invisible absolute top-0 right-0 -mt-1 -mr-1 inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-300 bg-white text-sm text-slate-600 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 hover:border-slate-500 hover:bg-slate-50 focus:visible focus:opacity-100 focus:ring-2 focus:ring-slate-400 focus:outline-none sm:-mr-9"
    data-clipboard-text={citation}
    aria-label={`複製 ${sectionId} 此段引用（含免責聲明）`}
    title="複製此段引用"
  >
    <span aria-hidden="true">📋</span>
  </button>
</div>
