---
// 全站共用：引用複製的 toast 反饋 + delegated click handler。
// 監聽任何 `.citation-copy[data-clipboard-text]` 的點擊，呼叫 navigator.clipboard，
// 成功／失敗顯示 toast。BaseLayout 應只 include 一次。
---

<div
  id="citation-toast"
  role="status"
  aria-live="polite"
  data-visible="false"
  class="pointer-events-none fixed inset-x-0 bottom-6 z-50 flex justify-center px-4 opacity-0 transition-opacity duration-200 data-[visible=true]:opacity-100"
>
  <div
    class="pointer-events-auto rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-lg"
  >
    <span id="citation-toast-msg">已複製引用</span>
  </div>
</div>

<script>
  // delegated handler — 處理所有 .citation-copy 點擊
  const toast = document.getElementById('citation-toast');
  const msg = document.getElementById('citation-toast-msg');
  let hideTimer: number | undefined;

  function showToast(text: string) {
    if (!toast || !msg) return;
    msg.textContent = text;
    toast.dataset.visible = 'true';
    if (hideTimer) window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => {
      toast.dataset.visible = 'false';
    }, 1800);
  }

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest<HTMLButtonElement>('.citation-copy');
    if (!btn) return;

    const text = btn.dataset.clipboardText;
    if (!text) return;

    try {
      await navigator.clipboard.writeText(text);
      showToast('已複製引用（含免責聲明）');
    } catch {
      // fallback：選取一個臨時 textarea 並 execCommand('copy')
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showToast('已複製引用（含免責聲明）');
      } catch {
        showToast('複製失敗，請手動選取');
      }
    }
  });
</script>
