---
// /server-cert-br/ 全文頁的桌面錨點導覽（sidebar 第二區塊）。
// 規格：web-spec-doc/server-cert-br樣式變更.txt（2026-05-25）。
// - 顯示階層最多到第二層（如 7.2、appendix-a）
// - desktop：sticky 於右欄上方
// - mobile：本元件不渲染（mobile 入口由 BrAnchorNavMobile 提供）
// - scrollspy 與 drawer 控制 script 一併放於此元件，可同時更新桌面卡片與
//   mobile drawer 的高亮（透過共用的 [data-anchor-link] 選擇器）。
import { getCollection } from 'astro:content';
import { compareSectionId, sectionIdDepth, sectionIdToLabel } from '../lib/section';

const all = await getCollection('br');

const topLevel = all.filter((e) => e.data.section_id.split('.').length <= 2);
const sorted = topLevel.sort((a, b) => compareSectionId(a.data.section_id, b.data.section_id));

function sectionIdToAnchorSlug(id: string) {
  return id.replace(/\./g, '-');
}
function cleanTitle(t: string) {
  return t.replace(/^\s*\d+(?:\.\d+)*\s*[、：:.\-—]?\s*/, '').trim() || t;
}
---

<nav
  aria-label="章節錨點"
  class="cabf-card bg-white border border-slate-200 rounded lg:sticky lg:top-6"
>
  <div class="border-b border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700">
    本頁章節
  </div>
  <ul class="py-2 text-sm max-h-[calc(100vh-9rem)] overflow-y-auto">
    {sorted.map((e) => {
      const id = e.data.section_id;
      const depth = sectionIdDepth(id);
      const indent = depth === 0 ? 'pl-3' : 'pl-7';
      const slug = sectionIdToAnchorSlug(id);
      return (
        <li>
          <a
            href={`#sec-${slug}`}
            data-anchor-link={`sec-${slug}`}
            class:list={[
              'block py-1 pr-3 leading-snug border-l-[3px] border-transparent text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition',
              indent,
            ]}
          >
            <span class="font-mono text-[11px] text-slate-500 mr-1.5">{sectionIdToLabel(id)}</span>
            <span>{cleanTitle(e.data.title)}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<script>
  // Drawer open/close（drawer 元素由 BrAnchorNavMobile 渲染；若不存在則為 no-op）
  const openBtn = document.getElementById('anchor-drawer-open');
  const drawer = document.getElementById('anchor-drawer');
  const closeBtn = document.getElementById('anchor-drawer-close');
  const backdrop = drawer?.querySelector('[data-anchor-backdrop]');

  const setDrawer = (open: boolean) => {
    if (!drawer || !openBtn) return;
    drawer.classList.toggle('hidden', !open);
    drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.style.overflow = open ? 'hidden' : '';
  };

  openBtn?.addEventListener('click', () => setDrawer(true));
  closeBtn?.addEventListener('click', () => setDrawer(false));
  backdrop?.addEventListener('click', () => setDrawer(false));
  drawer?.querySelectorAll('a[data-anchor-link]').forEach((a) => {
    a.addEventListener('click', () => setDrawer(false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
      setDrawer(false);
    }
  });

  // Scrollspy via IntersectionObserver（同時更新桌面卡片與 mobile drawer 高亮）
  const allLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-anchor-link]');
  const activeCls = ['border-bs-primary', 'bg-sky-50', 'text-bs-secondary', 'font-medium'];
  const idleCls = ['border-transparent', 'text-slate-700'];
  const setActive = (id: string | null) => {
    allLinks.forEach((a) => {
      const target = a.getAttribute('data-anchor-link');
      const on = target === id;
      activeCls.forEach((c) => a.classList.toggle(c, on));
      if (on) idleCls.forEach((c) => a.classList.remove(c));
      else idleCls.forEach((c) => a.classList.add(c));
    });
  };

  const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-anchor-target]'));
  if (targets.length > 0) {
    const visibility = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = (entry.target as HTMLElement).id;
          if (!id) return;
          visibility.set(id, entry.isIntersecting ? entry.intersectionRatio : 0);
        });
        const visible = targets
          .filter((t) => (visibility.get(t.id) ?? 0) > 0)
          .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);
        if (visible[0]) setActive(visible[0].id);
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: [0, 0.1, 0.5, 1] }
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
